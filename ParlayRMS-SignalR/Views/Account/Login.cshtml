@model ParlayRMS.ViewModel.Account.Login
@{
    ViewBag.Title = "Login";
}
<html>
<head>
    <title>@ViewBag.Title</title>
    <link href="@Url.Content("~/Content/Account/Login.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/Validators.css")" rel="stylesheet" type="text/css" />
    <script type="text/javascript" src="@Url.Content("~/Scripts/Lib/jquery-1.7.2.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/Lib/jquery-ui-1.8.21.custom.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/Validators.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/Account/Login.js")"></script>
</head>
<body>
    @using (Html.BeginForm())
    {
        <div class="content" style="text-align: center">
            <div class="loginheader">
                <div class="loginlogo">
                </div>
                <div class="blank">
                </div>
            </div>
            <div class="loginboder">
                <div style="width: 100%;">
                </div>
                <div>
                    @Html.LabelFor(m => m.UserName, ParlayRMS.Utility.ViewLang.Username)@Html.TextBoxFor(m => m.UserName, new { @class = "inputLogin" })
                </div>
                <div>@Html.LabelFor(m => m.Password, ParlayRMS.Utility.ViewLang.Password)@Html.PasswordFor(m => m.Password, new { @class = "inputLogin" })
                </div>
                <div>
                    <button class="button" type="submit" id="submit" title="@ParlayRMS.Utility.ViewLang.Login">
                        @ParlayRMS.Utility.ViewLang.Login
                    </button>
                </div>
                <div class="errmsg">
                    @CurrentContext.LoginErrorMessage
                    @{CurrentContext.LoginErrorMessage = string.Empty;}
                </div>
            </div>
        </div>
    }
    <script type="text/javascript">
        $(function () {
            $('#Password').keypress(function (event) {
                if (event.keyCode == 13) {
                    $('#submit').click();
                }
            });

            return false;
        })
    </script>
</body>
</html>