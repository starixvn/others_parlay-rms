<!DOCTYPE html>
<html lang="en">
<head>
    <meta content="text/html" charset="utf-8" />
    <title>@ViewBag.Title - PARLAY RMS</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/Content/themes/base/css")" rel="stylesheet" type="text/css" />
    <link href="@System.Web.Optimization.BundleTable.Bundles.ResolveBundleUrl("~/Content/css")" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" type="text/css" href="http://fonts.googleapis.com/css?family=Abel" />
    @if (ParlayRMS.Utility.AppSetting.IsDebug)
    {
        <script src="@Url.Content("~/Scripts/Lib/jquery-1.7.2.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.8.21.custom.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/HighChart/highcharts.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery.cookie.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/BetterTooltip/jquery.betterTooltip.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/Popup/jquery.simplemodal-1.4.2.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/jQueryExtension.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Confirm.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Core.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Popup.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Menu.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Validators.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Loading.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/LoadingInPopup.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/ErrorMessageInPopup.js")" type="text/javascript"></script>
    }
    else
    {
        <script src="@Url.Content("~/Scripts/Lib/jquery-1.7.2.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery-ui-1.8.21.custom.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/HighChart/highcharts.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/jquery.cookie.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/BetterTooltip/jquery.betterTooltip.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Lib/Popup/jquery.simplemodal-1.4.2.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/jQueryExtension.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Confirm.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Core.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Popup.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Menu.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Validators.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Loading.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/LoadingInPopup.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/ErrorMessageInPopup.js")" type="text/javascript"></script>

    }
    <script type="text/javascript">

        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }
    </script>
    <meta name="viewport" content="width=device-width" />
    @RenderSection("Head", false)
    @RenderSection("Script", false)
</head>
<body>
    <div id="mainPage">
        <div class="top-bar">
            @Html.Action("_Menu", "Shared")
        </div>
        @if (ViewBag.isShowTitle)
        {
            <div class="header showcase">
                <div class="content posrel">
                    <h1>@ViewBag.Title</h1>
                </div>
            </div>
        }
        <div class="body showcase">
            <div class="content">
                <div class="clear-fix">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</body>
</html>
@Html.Action("_Popup", "Shared")
@Html.Action("_Loading", "Shared")
@Html.Action("_ConfirmBox", "Shared")