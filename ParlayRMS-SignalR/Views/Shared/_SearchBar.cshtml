@{
    var groupId = ParlayRMS.Utility.Utils.ToInt32(Session["groupId"]);
}
<div class="search-content">
    <div class="search-input">
        @Html.Label("UserName", ParlayRMS.Utility.ViewLang.Username)
        @Html.TextBox("UserName", string.Empty, new { @class = "inputtext" })
    </div>
    <div class="search-autocomplete">
        <div class="ui-widget">
            <select id="SearchOption">
                <option value="0">All Groups</option>
                @foreach (Group group in ViewBag.GroupList)
                {
                    var selected = "";

                    if (groupId == group.Id)
                    {
                        selected = "selected=\"true\"";
                    }

                    <option value="@group.Id" @selected>@group.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="search-button">
        <button onclick="Search_onclick('UserName','SearchOption');">
            @ParlayRMS.Utility.ViewLang.Search</button></div>
    <div class="search-statistic">
        <div class="search-active">
            @Html.Label("ActiveUser", ParlayRMS.Utility.ViewLang.ActiveUser) : <span id="activeNumber">
            </span>
        </div>
        <div class="search-inactive">
            @Html.Label("InActiveUser", ParlayRMS.Utility.ViewLang.InactiveUser) : <span id="inactiveNumber">
            </span>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $('#UserName').keypress(function (event) {
            if (event.keyCode == 13) {
                Search_onclick('UserName', 'SearchOption');
            }
        });

        return false;
    });
</script>