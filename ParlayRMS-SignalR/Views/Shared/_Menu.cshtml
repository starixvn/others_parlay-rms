@{

    var menuDict = ViewBag.MenuDict as Dictionary<string, ParlayRMS.ViewModel.Shared.MenuItem>;
    var isFirst = true;
}
<div class="menu">
    <div class="content">
        <a href="@Url.Content("~/")" class="logo over-em"></a>
        @foreach (var value in menuDict.Values)
        {
            <ul class="@(isFirst == true ? "nav nav_line" : "nav")">
                <li class="tab"><a href="@(string.IsNullOrEmpty(value.Url) ? '#'.ToString() : value.Url)">
                    <span>@value.Name</span></a>
                    <ul class="sub-nav" style="display: none">
                        @foreach (var menu in value.Children)
                        {
                            <li><a href='@(menu.Url != "" ? @Url.Content(menu.Url) : "")'>@menu.Name</a></li>
                        }
                    </ul>
                </li>
            </ul>
                        isFirst = false;
        }
        <div class="welcome ">
            <div class="welcomehead">
                @ParlayRMS.Utility.ViewLang.Loggedinas<span style="color: #ff6300; font-weight: bold">&nbsp;
                    @Session[CurrentSession.ParlayRmsUsername].ToString()</span>
                <div class="arrow">
                </div>
            </div>
            <div class="welcomebody">
                <div class="welcomebody-sub">
                    <a href="javascript:ChangePassword(@CurrentSession.Instance.UserId, @CurrentSession.Instance.UserId, '@CurrentSession.Instance.UserName');">@ParlayRMS.Utility.ViewLang.ChangePassword</a></div>
                <div class="welcomebody-sub">
                    <a href="javascript:logOff()">@ParlayRMS.Utility.ViewLang.Logout</a></div>
            </div>
        </div>
    </div>
</div>