@using ParlayRMS.Utility
@{
    var link = "<a onclick=\"ProcessTabularByTurnover({0}, '{1}', this)\" style=\"cursor: pointer\">{2}</a>";

}
@model IEnumerable<ParlayRMS.DTO.RMS_Monitor_Parlay_SelectionByTurnover>
<div class="tabular">
    <div id="tabSelectionByTurnover" class="toptitle">
        <div class="minimizecontent">
            @ParlayRMS.Utility.ViewLang.TopSelelctionByTurnover
        </div>
        <div id="Loading_Tabular_TopSelectionByTurnover" class="tabloading">
        </div>
        <div id="tabular_topSelectionByTurnover_dataminimize" class="minimize" onclick="Minimize('tabular_topSelectionByTurnover','tabular_topSelectionByTurnover_dataminimize', 'tabSelectionByTurnover');">
            -
        </div>
    </div>
    <div id="tabular_topSelectionByTurnover" class="tabularcontainer">
        <table id="tblTurnover">
            <colgroup>
            </colgroup>
            @foreach (var item in Model)
            {
                <colgroup>
                </colgroup>
            }
            <thead>
                <tr>
                    <th class="Nobackground">
                        @ParlayRMS.Utility.ViewLang.Selectiontype
                    </th>
                    @foreach (var item in Model)
                    {
                        <th>
                            @item.Selection
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th class="Nobackground">
                        @ParlayRMS.Utility.ViewLang.Allsports
                    </th>
                    @foreach (var item in Model)
                    {
                        <td>
                            @Html.Raw(string.Format(link, item.Selection, ViewLang.Allsports, item.All_Sports.ToStringFormat()))
                        </td>
                    }
                </tr>
                <tr>
                    <th class="Nobackground">
                        @ParlayRMS.Utility.ViewLang.Socceronly
                    </th>
                    @foreach (var item in Model)
                    {
                        <td>
                            @Html.Raw(string.Format(link, item.Selection, ViewLang.Socceronly, item.Soccer_Only.ToStringFormat()))
                        </td>
                    }
                </tr>
                <tr>
                    <th class="Nobackground">
                        @ParlayRMS.Utility.ViewLang.Combinedsports
                    </th>
                    @foreach (var item in Model)
                    {
                        <td>
                            @Html.Raw(string.Format(link, item.Selection, ViewLang.Combinedsports, item.Combined_Sports.ToStringFormat()))
                        </td>
                    }
                </tr>
                <tr>
                    <th class="Nobackground">
                        @ParlayRMS.Utility.ViewLang.Othersports
                    </th>
                    @foreach (var item in Model)
                    {
                        <td>
                            @Html.Raw(string.Format(link, item.Selection, ViewLang.Othersports, item.Other_Sports.ToStringFormat()))
                        </td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
</div>