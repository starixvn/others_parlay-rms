@using ParlayRMS.Utility
@model IEnumerable<ParlayRMS.DTO.RMS_Monitor_Parlay_SelectionByTicket>
@{
    var link = "<a onclick=\"ProcessTabularByTicket({0}, '{1}', this)\" style=\"cursor: pointer\">{2}</a>";

}
<div class="tabular">
    <div id="tabSelectionByTicket" class="toptitle">
        <div class="minimizecontent">
            @ParlayRMS.Utility.ViewLang.TopSelectionByTickets
        </div>
        <div id="Loading_Tabular_TopSelectionByTicket" class="tabloading">
        </div>
        <div id="tabular_topSelectionByTicket_dataminimize" class="minimize" onclick="Minimize('tabular_topSelectionByTicket','tabular_topSelectionByTicket_dataminimize', 'tabSelectionByTicket');">
            -
        </div>
    </div>
    <div id="tabular_topSelectionByTicket" class="tabularcontainer">
        <table id="tblTicket">
            <colgroup>
            </colgroup>
            @foreach (var item in Model)
            {
                <colgroup>
                </colgroup>
            }
            <thead>
                <tr>
                    <th class="Nobackground">
                        @ParlayRMS.Utility.ViewLang.Selectiontype
                    </th>
                    @foreach (var item in Model)
                    {
                        <th>
                            @item.Selection
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th class="Nobackground">
                        @ParlayRMS.Utility.ViewLang.Allsports
                    </th>
                    @foreach (var item in Model)
                    {
                        <td>
                            @Html.Raw(string.Format(link, item.Selection, ViewLang.Allsports, Utils.ToStringFormat(item.All_Sports)))
                        </td>
                    }
                </tr>
                <tr>
                    <th class="Nobackground">
                        @ParlayRMS.Utility.ViewLang.Socceronly
                    </th>
                    @foreach (var item in Model)
                    {
                        <td>
                            @Html.Raw(string.Format(link, item.Selection, ViewLang.Socceronly, Utils.ToStringFormat(item.Soccer_Only)))
                        </td>
                    }
                </tr>
                <tr>
                    <th class="Nobackground">
                        @ParlayRMS.Utility.ViewLang.Combinedsports
                    </th>
                    @foreach (var item in Model)
                    {
                        <td>
                            @Html.Raw(string.Format(link, item.Selection, ViewLang.Combinedsports, Utils.ToStringFormat(item.Combined_Sports)))
                        </td>
                    }
                </tr>
                <tr>
                    <th class="Nobackground">
                        @ParlayRMS.Utility.ViewLang.Othersports
                    </th>
                    @foreach (var item in Model)
                    {
                        <td>
                            @Html.Raw(string.Format(link, item.Selection, ViewLang.Othersports, Utils.ToStringFormat(item.Other_Sports)))
                        </td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
</div>