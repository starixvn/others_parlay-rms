@model ParlayRMS.ViewModel.ManageGroup.CreateGroupModel
@{
    ViewBag.Title = "CreateGroup";
}
<div class="boxMain">
    <div class="container">
        <div class="content">
            <div class="allField">
                <div class="title">
                    @ParlayRMS.Utility.ViewLang.NewGroup
                </div>
                <div class="lineTop">
                </div>
                <div class="lineBottom">
                </div>
                <div class="label">
                    @Html.LabelFor(m => m.Name, ParlayRMS.Utility.ViewLang.GroupName)
                </div>
                <div class="field">
                    @Html.TextBoxFor(m => m.Name, string.Empty, new { @class = "inputtext w330" })
                </div>
                <div class="label_areatext">
                    @Html.LabelFor(m => m.Description, ParlayRMS.Utility.ViewLang.Description)
                </div>
                <div class="field_areatext">
                    @Html.TextAreaFor(m => m.Description, new { @class = "areatext w330", rows = "7", maxlength = "330", onkeyup = "limitInput(this)" })
                </div>
                <div class="actionbar">
                    <div class="actionbar-line">
                        @Html.Action("_LoadingInPopUp", "Shared")
                        <div id="errMsg" class="warningmsg">
                        </div>
                        <div class="button-action">
                            <button id="btnSubmitNewGroup" onclick="javascript:saveCreateGroup();">
                                <span class="text">@ParlayRMS.Utility.ViewLang.Submit</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $("#btnSubmitNewGroup").addClass("button");
    });
</script>