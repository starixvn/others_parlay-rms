@using ParlayRMS.Models
@{
    ViewBag.Title = "Group Management";
    ViewBag.isShowTitle = true;
}
@{
    Html.RenderPartial("NewBar");

}
<div class="scrollGridBorder">
    <div class="scrollGridHeader">
        <table class="scrollGrid">
            <tr>
                <td style="width: 200px">
                    @ParlayRMS.Utility.ViewLang.GroupName
                </td>
                <td style="width: 100px">
                    @ParlayRMS.Utility.ViewLang.NumberOfUser
                </td>
                <td style="width: auto">
                    @ParlayRMS.Utility.ViewLang.Remark
                </td>
                <td style="width: 100px">
                    @ParlayRMS.Utility.ViewLang.Creator
                </td>
                <td style="width: 170px">
                    @ParlayRMS.Utility.ViewLang.CreatedDate
                </td>
                <td style="width: 90px">
                    @ParlayRMS.Utility.ViewLang.Permission
                </td>
            </tr>
        </table>
    </div>
    <div id="groupScrollGrid" class="scrollGridContent">
        <table id="tblGroupList" class="scrollGrid">
            @foreach (Group group in ViewBag.GroupList)
            {
                <tr>
                    <td style="width: 200px">
                        <a href="#" onclick="javascript:EditGroup('@group.Id');">@group.Name</a>
                    </td>
                    <th style="width: 100px">
                        <button style="width: 60px;" onclick="javascript:GetUserByGroup(@group.Id)">
                            @group.NumberOfMember
                        </button>
                    </th>
                    <td style="width: auto">
                        @group.Description
                    </td>
                    <td style="width: 100px">
                        @group.Creator.Name
                    </td>
                    <th style="width: 170px">
                        @group.CreateDate
                    </th>
                    <th style="width: 90px">
                        <button onclick="javascript:CreateNewGroupPolicy('@group.Id','@group.Name')">
                            ...</button>
                    </th>
                </tr>

            }
        </table>
    </div>
</div>
@section Script{
    @if (ParlayRMS.Utility.AppSetting.IsDebug)
    {
        <script src="@Url.Content("~/Scripts/ManageGroup.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/ManageUser.js")" type="text/javascript"></script>

    }
    else
    {
        <script src="@Url.Content("~/Scripts/ManageGroup.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/ManageUser.js")" type="text/javascript"></script>
    }
}