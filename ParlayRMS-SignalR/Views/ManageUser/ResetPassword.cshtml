@model ParlayRMS.ViewModel.Account.LoginModel
@{
    ViewBag.Title = ParlayRMS.Utility.ViewLang.ChangePassword;
}
<div class="boxMain">
    <div class="container">
        <div class="content">
            <div class="allField">
                <div class="title">
                    Reset Password
                </div>
                <div class="lineTop">
                </div>
                <div class="lineBottom">
                </div>
                <div class="labelNoneBorder">
                    @ParlayRMS.Utility.ViewLang.Username
                </div>
                <div class="fieldNoneBorder">
                    @ViewBag.Username
                </div>
                <div class="label">
                    @Html.LabelFor(m => m.NewPassword, ParlayRMS.Utility.ViewLang.Newpassword)
                </div>
                <div class="field">
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "inputtext w230" })
                </div>
                <div class="label">
                    @Html.LabelFor(m => m.ConfirmNewPassword, ParlayRMS.Utility.ViewLang.Confirmpassword)
                </div>
                <div class="field">
                    @Html.PasswordFor(m => m.ConfirmNewPassword, new { @class = "inputtext w230" })
                </div>
                <div class="actionbar">
                    <div class="actionbar-line">
                        @Html.Action("_LoadingInPopUp", "Shared")
                        <div id="errMsg" class="warningmsg">
                        </div>
                        <div class="button-action">
                            <button id="btnSubmit" onclick="javascript:ResetPwd(@ViewBag.UserId)">
                                <span class="text">@ParlayRMS.Utility.ViewLang.Submit</span></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $("#btnSubmit").addClass("button");
    });
</script>