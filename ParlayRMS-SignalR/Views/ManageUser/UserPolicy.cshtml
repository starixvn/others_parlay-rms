@model ParlayRMS.ViewModel.ManageGroup.CreateGroupPolicyModel
@{
    ViewBag.Title = "Edit User Policy";
}
<div class="boxMain">
    <div class="container">
        <div class="content">
            <div class="allField">
                <div class="title">
                    @ParlayRMS.Utility.ViewLang.GrantPermission: <span style="color: #ff6300">@ViewBag.Username</span>
                </div>
                <div class="lineTop">
                </div>
                <div class="lineBottom">
                </div>
                <div class="fieldbar">
                    <table id="tblfuntion" style="width: 100%">
                        <tr>
                            <th rowspan="2">
                                @ParlayRMS.Utility.ViewLang.Functions
                            </th>
                            <th colspan="2">
                                @ParlayRMS.Utility.ViewLang.UserPermission
                            </th>
                            <th colspan="2">
                                @ParlayRMS.Utility.ViewLang.GroupPermission
                            </th>
                        </tr>
                        <tr>
                            <th>
                                @ParlayRMS.Utility.ViewLang.Read
                            </th>
                            <th>
                                @ParlayRMS.Utility.ViewLang.Write
                            </th>
                            <th>
                                @ParlayRMS.Utility.ViewLang.Read
                            </th>
                            <th>
                                @ParlayRMS.Utility.ViewLang.Write
                            </th>
                        </tr>
                        @foreach (Function fn in ViewBag.UserFunc)
                        {

                            string activeR = "inactive";
                            string activeW = "inactive";
                            string val = "0";

                            string activeGroupR = "inactive";
                            string activeGroupW = "inactive";

                            if (fn.UserPolicy != null)
                            {
                                if (fn.UserPolicy.Write)
                                {
                                    activeR = activeW = "active";
                                    val = "2";
                                }
                                else if (fn.UserPolicy.Read)
                                {
                                    activeR = "active";
                                    activeW = "inactive";
                                    val = "1";
                                }
                                else
                                {
                                    activeR = activeW = "inactive";
                                }
                            }

                            if (fn.GroupPolicy != null)
                            {
                                if (fn.GroupPolicy.Write)
                                {
                                    activeGroupR = activeGroupW = "active";
                                }
                                else if (fn.GroupPolicy.Read)
                                {
                                    activeGroupR = "active";
                                    activeGroupW = "inactive";
                                }
                                else
                                {
                                    activeGroupR = activeGroupW = "inactive";
                                }
                            }

                            <tr>
                                <td>
                                    <span class="function">@fn.Name</span>
                                </td>
                                <td>
                                    <div id="r-@fn.Id" class="@activeR" parent="r-@fn.Id" permission="1" onclick="grantPermissionsRead(this);">
                                    </div>
                                </td>
                                <td>
                                    <div id="w-@fn.Id" class="@activeW" parent="w-@fn.Id" val="@val" permission="2" onclick="grantPermissionsWrite(this);">
                                    </div>
                                </td>
                                <td style="background-color: #dbdbdb">
                                    <div class="@activeGroupR" style="cursor: default" >
                                    </div>
                                </td>
                                <td style="background-color: #dbdbdb">
                                    <div class="@activeGroupW" style="cursor: default" >
                                    </div>
                                </td>
                            </tr>
                            foreach (Function subfn in ViewBag.UserSubFunc)
                            {
                                if (fn.Id == subfn.Parent.Id)
                                {

                                    string SubactiveR = "inactive";
                                    string SubactiveW = "inactive";
                                    string Subval = "0";

                                    string SubactiveGroupR = "inactive";
                                    string SubactiveGroupW = "inactive";

                                    if (subfn.UserPolicy != null)
                                    {
                                        if (subfn.UserPolicy.Write)
                                        {
                                            SubactiveR = SubactiveW = "active";
                                            Subval = "2";
                                        }
                                        else if (subfn.UserPolicy.Read)
                                        {
                                            SubactiveR = "active";
                                            SubactiveW = "inactive";
                                            Subval = "1";
                                        }
                                        else
                                        {
                                            SubactiveR = SubactiveW = "inactive";
                                        }
                                    };

                                    if (subfn.GroupPolicy != null)
                                    {
                                        if (subfn.GroupPolicy.Write)
                                        {
                                            SubactiveGroupR = SubactiveGroupW = "active";
                                        }
                                        else if (subfn.GroupPolicy.Read)
                                        {
                                            SubactiveGroupR = "active";
                                            SubactiveGroupW = "inactive";
                                        }
                                        else
                                        {
                                            SubactiveGroupR = SubactiveGroupW = "inactive";
                                        }
                                    }
                            <tr>
                                <td>
                                    <span class="subfunction">- @subfn.Name</span>
                                </td>
                                <td>
                                    <div id="r-@subfn.Id" parent="r-@subfn.Parent.Id" permission="1" class="@SubactiveR" onclick="grantPermissions(this);">
                                    </div>
                                </td>
                                <td>
                                    <div id="w-@subfn.Id" parent="w-@subfn.Parent.Id" val="@Subval"  permission="2" class="@SubactiveW" onclick="grantPermissions(this);">
                                    </div>
                                </td>
                                <td style="background-color: #dbdbdb">
                                    <div class="@SubactiveGroupR" style="cursor: default" >
                                    </div>
                                </td>
                                <td style="background-color: #dbdbdb">
                                    <div class="@SubactiveGroupW" style="cursor: default" >
                                    </div>
                                </td>
                            </tr>
                                }
                            }
                        }
                    </table>
                </div>
                <div class="actionbar">
                    <div class="actionbar-line">
                        @Html.Action("_LoadingInPopUp", "Shared")
                        <div id="errMsg" class="warningmsg">
                        </div>
                        <div class="button-action">
                            <button class="button" id="btnSubmit" onclick="javascript:saveUserPolicy(@ViewBag.UserId);">
                                <span class="text">@ParlayRMS.Utility.ViewLang.Submit</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $('#btnSubmit').button();
    });
</script>
@Html.HiddenFor(m => m.GroupId, "groupid")
@Html.HiddenFor(m => m.GroupPolicy, "grouppolicy")