@using ParlayRMS.Models
@{
    ViewBag.Title = "User Management";
    ViewBag.isShowTitle = true;
}
@{
    Html.RenderPartial("NewBar");
    Html.RenderPartial("_SearchBar", "Shared");
}
<div class="scrollGridBorder">
    <div class="scrollGridHeader">
        <table class="scrollGrid">
            <tr>
                <td style="width: auto">
                    @ParlayRMS.Utility.ViewLang.Username
                </td>
                <td style="width: 150px">
                    @ParlayRMS.Utility.ViewLang.Firstname
                </td>
                <td style="width: 150px">
                    @ParlayRMS.Utility.ViewLang.Lastname
                </td>
                <td style="width: 150px">
                    @ParlayRMS.Utility.ViewLang.GroupName
                </td>
                <td style="width: 150px">
                    @ParlayRMS.Utility.ViewLang.Creator
                </td>
                <td style="width: 170px">
                    @ParlayRMS.Utility.ViewLang.CreatedDate
                </td>
                <td style="width: 100px">
                    @ParlayRMS.Utility.ViewLang.Permission
                </td>
                <td style="width: 60px">
                    @ParlayRMS.Utility.ViewLang.Active
                </td>
                <td style="width: 90px">
                    @ParlayRMS.Utility.ViewLang.Password
                </td>
            </tr>
        </table>
    </div>
    <div id="groupScrollGrid" class="scrollGridContent">
        <table id="tblGroupList" class="scrollGrid">
            @foreach (ParlayRMS.Models.User user in ViewBag.UserList)
            {
                <tr>
                    <td style="width: auto">
                        <a href="javascript:EditInfo(@user.Id, '@user.UserName', '@user.FirstName', '@user.LastName', @user.Group.Id)">@user.UserName</a>
                    </td>
                    <td style="width: 150px">
                        @user.FirstName
                    </td>
                    <td style="width: 150px">
                        @user.LastName
                    </td>
                    <td style="width: 150px">
                        @user.Group.Name
                    </td>
                    <td style="width: 150px">
                        @user.Creator.UserName
                    </td>
                    <td style="width: 170px; text-align: center">
                        @user.CreatedDate
                    </td>
                    <td style="width: 100px; text-align: center">
                        <button onclick="javascript:GetUserPermission(@user.Id, '@user.UserName')">
                            ...</button>
                    </td>
                    <td style="width: 60px">
                        <div onclick="javascript:ProcessCheckBox(@user.Id, '@user.UserName', this, 'ManageUser/UpdateStatus')" class="@ParlayRMS.Utility.Utils.ResolveCheckBox(user.IsActive)">
                        </div>
                    </td>
                    <td style="width: 90px">
                        <div onclick="javascript:ResetPassword(@user.Id, '@user.UserName')" class="resetPassword">
                        </div>
                    </td>
                </tr>
            }
        </table>
    </div>
</div>
<div style="display: none">
    <label id="active">@ViewBag.ActiveUser</label>
    <label id="inactive">@ViewBag.InactiveUser</label>
</div>
@section Script{
    @if (ParlayRMS.Utility.AppSetting.IsDebug)
    {
        <script src="@Url.Content("~/Scripts/ManageUser.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Search.js")" type="text/javascript"></script>

    }
    else
    {   <script src="@Url.Content("~/Scripts/ManageUser.js")" type="text/javascript"></script>
        <script src="@Url.Content("~/Scripts/Search.js")" type="text/javascript"></script>
    }
}