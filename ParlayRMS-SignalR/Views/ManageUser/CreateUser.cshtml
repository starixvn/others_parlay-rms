@model ParlayRMS.ViewModel.Account.UserModel
<div class="boxMain">
    <div class="container">
        <div class="content">
            <div class="allField">
                <div class="title">
                    @ParlayRMS.Utility.ViewLang.NewUser
                </div>
                <div class="lineTop">
                </div>
                <div class="lineBottom">
                </div>
                <div class="label">
                    @Html.LabelFor(m => m.Username, ParlayRMS.Utility.ViewLang.Username)
                </div>
                <div class="field">
                    @Html.TextBoxFor(m => m.Username, new { @class = "inputtext w230" })
                </div>
                <div class="label">
                    @Html.LabelFor(m => m.Password, ParlayRMS.Utility.ViewLang.Password)
                </div>
                <div class="field">
                    @Html.PasswordFor(m => m.Password, new { @class = "inputtext w230" })
                </div>
                <div class="label">
                    @Html.LabelFor(m => m.FirstName, ParlayRMS.Utility.ViewLang.Firstname)
                </div>
                <div class="field">
                    @Html.TextBoxFor(m => m.FirstName, new { @class = "inputtext w230" })
                </div>
                <div class="label">
                    @Html.LabelFor(m => m.LastName, ParlayRMS.Utility.ViewLang.Lastname)
                </div>
                <div class="field">
                    @Html.TextBoxFor(m => m.LastName, new { @class = "inputtext w230" })
                </div>
                <div class="labelNoneBorder">
                    @Html.LabelFor(m => m.GroupName, ParlayRMS.Utility.ViewLang.GroupName)
                </div>
                <div class="fieldNoneBorder">
                    @Html.DropDownListFor(m => m.GroupName, (IEnumerable<SelectListItem>)ViewBag.GroupList, new { @class = "w230" })
                </div>
                <div class="actionbar">
                    <div class="actionbar-line">
                        @Html.Action("_LoadingInPopUp", "Shared")
                        <div id="errMsg" class="warningmsg">
                        </div>
                        <div class="button-action">
                            <button id="btnSubmit" onclick="javascript:CreateUserInfo()">
                                <span class="text">@ParlayRMS.Utility.ViewLang.Submit</span></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $("#btnSubmit").addClass("button");
    });
</script>