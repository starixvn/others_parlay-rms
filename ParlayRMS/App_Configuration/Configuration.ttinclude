<#@ import namespace="System" #>
<#
    var sites = new SiteInfo[]{
         new SiteInfo
        {
            Environment = SiteEnvironment.LOCAL
        },
         new SiteInfo
        {
            Environment = SiteEnvironment.DEV
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.MASTER
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.SIT
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.UAT
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.MNL
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.PRO
        }
    };
#>
<#+
    enum SiteEnvironment
    {
        DEV,
        LOCAL,
        MASTER,
        SIT,
        UAT,
        MNL,
        PRO
    }
    class SiteInfo
    {
        public SiteEnvironment Environment { get; set; }

        public string MSMQPath
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                        return "http://10.40.40.127/msmq/Private$/entlib";

                    case SiteEnvironment.MNL:
                        return "http://10.2.98.3/private$/entlib";

                    case SiteEnvironment.SIT:
                    case SiteEnvironment.UAT:
                        return "http://172.16.4.106/private$/entlib";

                    default:
                        return "http://10.18.200.209/private$/entlib";
                }
            }
        }

        public string UMServiceURL
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                        return "http://10.40.40.22:8889/api";

                    case SiteEnvironment.MNL:
                        return "http://10.40.40.22:8889/api";

                    case SiteEnvironment.SIT:
                    case SiteEnvironment.UAT:
                        return "http://10.40.40.22:8889/api";

                    default:
                        return "http://10.18.200.124:8889/api";
                }
            }
        }

        public string RemoteRefURL
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                        return "tcp://10.40.40.29:8098/CallGetRefFunction";

                    case SiteEnvironment.MNL:
                        return "tcp://10.40.40.130:8098/CallGetRefFunction";

                    case SiteEnvironment.SIT:
                    case SiteEnvironment.UAT:
                        return "tcp://10.40.40.225:8091/CallGetRefFunction";

                    default:
                        return "tcp://10.70.70.242:8888/CallGetRefFunction";
                }
            }
        }
                
        public string ErrorMode
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                             return "On";

                    default:
                        return "Off";
                }
            }
        }
        
        public string DebugMode
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                        return "false";

                    default:
                        return "true";
                }
            }
        }

        public string EnableCheckUM
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                        return "true";

                    default:
                        return "false";
                }
            }
        }

        public string SessionStateString
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                        return "<sessionState mode=\"StateServer\" timeout=\"10\" stateConnectionString=\"tcpip=10.40.40.135:42424\" />";
                    case SiteEnvironment.MNL:
                        return "<sessionState mode=\"StateServer\" timeout=\"10\" stateConnectionString=\"tcpip=10.2.12.10:42424\" />";
                    case SiteEnvironment.SIT:
                    case SiteEnvironment.UAT:
                        return "<sessionState mode=\"StateServer\" timeout=\"10\" stateConnectionString=\"tcpip=172.16.4.107:42424\" />";

                    default:
                        return "";
                }
            }
        }

        public string SPName
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.MASTER:
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.MNL:
                        return "~/App_Data/PRO/";

                    case SiteEnvironment.SIT:
                    case SiteEnvironment.UAT:
                        return "~/App_Data/UAT/";

                    default:
                        return "~/App_Data/LOCAL/";
                }
            }
        }
    }
#>