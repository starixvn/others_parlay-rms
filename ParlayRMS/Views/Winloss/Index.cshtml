@using ParlayRMS.Web.Mvc
@{
    ViewBag.Title = ViewBag.HeaderText = ViewLang.WinLoss;
}
<div class="filter">
    <div class="filter-control" style="width: 750px">
        <div class="minimizetitle">
            <div class="minimizecontent">
                @ViewLang.FilterControl</div>
            <div id="filterminimize" class="minimize" onclick="Minimize('filtercontent','filterminimize');">
                -
            </div>
        </div>
        <div id="filtercontent" class="container">
            <div class="row">
                <div class="group">
                    @Html.Label("parlayType", ViewLang.ParlayType)
                    @Html.DropDownList("parlayType", Config.ParlayTypes)
                </div>
                <div class="group">
                    @Html.Label("", ViewLang.From)
                    @Html.TextBox("fromDate")
                </div>
                <div class="group">
                    @Html.Label("", ViewLang.To)
                    @Html.TextBox("toDate")
                </div>
                <div class="group">
                    <button id="btnSearch">
                        <span class="text">@ViewLang.Submit</span>
                    </button>
                </div>
            </div>
            <div class="row">
                <div class="group">
                    @Html.Label(ViewLang.Combo)
                    @Html.DropDownList("combo", Config.Combos)
                </div>
                <div id="divSportsTypes" class="group">
                    @Html.Label(ViewLang.SportsType)
                    @Html.RadioButtonList("SportsTypes", Config.SportsTypes)
                </div>
            </div>
        </div>
    </div>
    <div style="clear: both; padding-top: 20px;" id="divResult">
    </div>
    @Scripts.Render("~/Scripts/Report/Winloss/js")
    <script type="text/javascript">
        var dateRanges = {
            LimitDataFromDate: '@DateTime.Now.AddMonths(-1)',
            NowDate: '@DateTime.Now'
        };
    </script>
</div>