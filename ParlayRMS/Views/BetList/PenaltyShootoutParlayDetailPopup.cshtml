@{
    Layout = null;
}
@model string
<div class="boxMain">
    <div class="content">
        <table class="bet-detail">
            <tr class="title2">
                <th>
                    Ticket Details - @ViewBag.Username - @ViewBag.TransId
                </th>
                <th class="combo-type">
                    @ViewLang.ComboType
                </th>
            </tr>
            <tr>
                <td>
                    <div class="betdetails">

                        <table style="width:100%">
                            <colgroup>
                                <col />
                                <col width="100" />
                            </colgroup>
                            <tr>
                                <td>@Html.Raw(ViewBag.Choice)</td>
                                <td></td>
                            </tr>
                        </table>
                    </div>
                </td>
                <td class="combo-type">
                    @ViewLang.PenaltyShootoutCombo
                </td>
            </tr>
        </table>
    </div>
</div>