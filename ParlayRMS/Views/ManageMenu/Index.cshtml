@model List<ParlayRMS.Models.Menus.Menu>
@{
    ViewBag.Title = ViewBag.HeaderText = ViewLang.MenuManagement;
}
<div id="barFunction" class="bar new-cmd title">
    <div style="float: left;">
        <button id="btnNewMenu" onclick="javascript:CreateMenu();">
            <span class="addNewMenu"></span><span class="text">@ViewLang.NewMenu</span>
        </button>
    </div>
</div>
<div class="scrollGridBorder">
    <div class="scrollGridHeader">
        <table class="scrollGrid">
        <colgroup>
                <col style="width: 180px" />
                <col style="width: auto" />
                <col style="width: 140px" />
                <col style="width: 240px" />
                <col style="width: 140px" />
                <col style="width: 70px" />
                <col style="width: 70px" />
                <col style="width: 170px" />
            </colgroup>
        <tbody>
            <tr>
                <td>
                    @ViewLang.Name
                </td>
                <td>
                    @ViewLang.Description
                </td>
                <td>
                    @ViewLang.Parent
                </td>
                <td>
                    @ViewLang.Url
                </td>
                <td>
                    @ViewLang.Function
                </td>
                <td>
                    @ViewLang.Order
                </td>
                <td>
                    @ViewLang.Active
                </td>
                <td>
                    @ViewLang.Lastmodified
                </td>
            </tr>
            </tbody>
        </table>
    </div>
    <div id="groupScrollGrid" class="scrollGridContent">
        <table id="tblFunctionList" class="scrollGrid">
                <colgroup>
                <col style="width: 180px" />
                <col style="width: auto" />
                <col style="width: 140px" />
                <col style="width: 240px" />
                <col style="width: 140px" />
                <col style="width: 70px" />
                <col style="width: 70px" />
                <col style="width: 170px" />
            </colgroup>
        <tbody>
            @{ foreach (var menu in Model)
               {
                <tr>
                    <td>
                        @if (menu.Parent != null)
                        {
                            <a href="#" onclick="javascript:EditMenu('@menu.Id');"><span class="subfunction">- @menu.Name</span></a>
                        }
                        else
                        {
                            <a href="#" onclick="javascript:EditMenu('@menu.Id');"><span class="function">@menu.Name</span></a>
                        }
                    </td>
                    <td>
                        @menu.Description
                    </td>
                    <td>
                        @(menu.Parent != null ? menu.Parent.Name : "")
                    </td>
                    <td>
                        @menu.Url
                    </td>
                    <td>
                        @menu.Function.Name
                    </td>
                    <td style="text-align: center">
                        @menu.DisplayOrder
                    </td>
                    <td style="text-align: center">
                        <div onclick="javascript:ToggleStatus(this, '@menu.Id', '@menu.Name')" class="@Utils.ResolveCheckBox(menu.IsActive)" />
                    </td>
                    <td style="text-align: center">
                        @menu.ModifiedDate
                    </td>
                </tr>
               }
            }
            </tbody>
        </table>
    </div>
</div>
@section Script{
    <script src="@Url.Content("~/Scripts/ManageMenu.js")" type="text/javascript"></script>
}