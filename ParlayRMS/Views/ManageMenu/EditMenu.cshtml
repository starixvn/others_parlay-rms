@using ParlayRMS.Models.Menus
@using ParlayRMS.Models.Functions
@model ParlayRMS.ViewModel.ManageMenu.EditMenuModel
@{
    Layout = "~/Views/Shared/_PopupLayout.cshtml";
    ViewBag.Title = ViewLang.EditMenu;
    ViewBag.Submit = string.Format("EditMenuPost({0})", Model.MenuId);
}
<div class="popup-content-label">
    @Html.LabelFor(m => m.MenuName)
</div>
<div class="popup-content-input">
    @Html.TextBoxFor(m => m.MenuName, new { @class = "popup-content-textbox w230" })
</div>
<div class="popup-content-label2">
    @Html.LabelFor(m => m.Description)
</div>
<div class="popup-content-input2">
    @Html.TextAreaFor(m => m.Description, new { @class = "popup-content-textarea w230", rows = "7", maxlength = "100", onkeyup = "limitInput(this)" })
</div>
<div class="popup-content-label">
    @Html.LabelFor(m => m.Url)
</div>
<div class="popup-content-input">
    @Html.TextBoxFor(m => m.Url, new { @class = "popup-content-textbox w230" })
</div>
<div class="popup-content-label2">
    @Html.LabelFor(m => m.FunctionId)
</div>
<div class="popup-content-input2">
    <select id="FunctionId" name="FunctionId" class="popup-content-select w230">
        @foreach (Function function in ViewBag.FunctionList)
        {
            <option value='@function.Id' @(function.Id == Model.FunctionId ? "selected=selected" : "") @(function.Parent != null ? "class=sub" : "")>@function.Name</option>
        }
    </select>
</div>
<div class="popup-content-label2">
    @Html.LabelFor(m => m.ParentId)
</div>
<div class="popup-content-input2">
    @Html.DropDownListFor(m => m.ParentId, (IEnumerable<SelectListItem>)ViewBag.MenuSelectList, new { @class = "popup-content-select w230" })
</div>
<div class="popup-content-label">
    @Html.LabelFor(m => m.DisplayOrder)
</div>
<div class="popup-content-input">
    @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "popup-content-textbox w230" })
</div>