@using ParlayRMS.Models.Menus
@using ParlayRMS.Models.Functions
@{
    var functionList = ViewBag.FunctionList as IEnumerable<Function>;
    //var functionSelectList = functionList.Select(x => new SelectListItem
    //{
    //    Value = x.Id.ToString(),
    //    Text = x.Name
    //}).ToList();

    var menuList = ViewBag.MenuList as IEnumerable<Menu>;
    var menuSelectList = menuList.Select(x => new SelectListItem
    {
        Value = x.Id.ToString(),
        Text = x.Name
    }).ToList();
    menuSelectList.Insert(0, new SelectListItem { Value = "0", Text = ViewLang.None });
}
@model ParlayRMS.ViewModel.ManageMenu.EditMenuModel
<div class="boxMain">
    <div class="container">
        <div class="content">
            <div class="allField">
                <div class="title">
                    @ViewLang.EditMenu
                </div>
                <div class="lineTop">
                </div>
                <div class="lineBottom">
                </div>
                <div class="label">
                    @Html.LabelFor(m => m.Name, ViewLang.Name)
                    @Html.HiddenFor(m => m.Id)
                </div>
                <div class="field">
                    @Html.TextBoxFor(m => m.Name, Model.Name, new { @class = "inputtext w230" })
                </div>
                <div class="label_areatext">
                    @Html.LabelFor(m => m.Description, ViewLang.Description)
                </div>
                <div class="field_areatext">
                    @Html.TextAreaFor(m => m.Description, new { @class = "areatext", rows = "7", maxlength = "100", onkeyup = "limitInput(this)" })
                </div>
                <div class="label">
                    @Html.LabelFor(m => m.Url, "URL")
                </div>
                <div class="field">
                    @Html.TextBoxFor(m => m.Url, Model.Url, new { @class = "inputtext w230" })
                </div>
                <div class="labelNoneBorder">
                    @Html.LabelFor(m => m.FunctionId, ViewLang.Function)
                </div>
                <div class="fieldNoneBorder">
                    <select id="FunctionId" name="FunctionId">
                        @foreach (var function in functionList)
                        {
                            <option value='@function.Id' @(function.Id == Model.FunctionId ? "selected=selected" : "") @(function.Parent != null ? "class=sub" : "")>@function.Name</option>
                        }
                    </select>
                </div>
                <div class="labelNoneBorder">
                    @Html.LabelFor(m => m.ParentId, ViewLang.Parent)
                </div>
                <div class="fieldNoneBorder">
                    @Html.DropDownListFor(m => m.ParentId, menuSelectList)
                </div>
                <div class="label">
                    @Html.LabelFor(m => m.DisplayOrder, ViewLang.Order)
                </div>
                <div class="field">
                    @Html.TextBoxFor(m => m.DisplayOrder, Model.DisplayOrder.ToString(), new { @class = "inputtext" })
                </div>
                <div class="actionbar">
                    <div class="actionbar-line">
                        <div id="lineloading" class="line-loading">
                            <img alt="" src="../../Images/Content/ajax-loader-line-2.gif" />
                        </div>
                        <div id="errMsg" class="warningmsg">
                        </div>
                        <div class="button-action">
                            <button id="btnSubmitEditMenu" onclick="javascript:SaveUpdateMenu();">
                                <span class="text">@ViewLang.Submit</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $('#btnSubmitEditMenu').addClass("button");
    });
</script>