@using ParlayRMS.Models.Menus
@using ParlayRMS.Models.Functions
@model ParlayRMS.ViewModel.ManageMenu.EditMenuModel
@{
    Layout = "~/Views/Shared/_PopupLayout.cshtml";
    ViewBag.Title = ViewLang.EditMenu;
    ViewBag.Submit = string.Format("EditMenuPost({0})", Model.MenuId);
}
<div class="label">
    @Html.LabelFor(m => m.MenuName)
</div>
<div class="field">
    @Html.TextBoxFor(m => m.MenuName, new { @class = "inputtext w230" })
</div>
<div class="label_areatext">
    @Html.LabelFor(m => m.Description)
</div>
<div class="field_areatext">
    @Html.TextAreaFor(m => m.Description, new { @class = "areatext", rows = "7", maxlength = "100", onkeyup = "limitInput(this)" })
</div>
<div class="label">
    @Html.LabelFor(m => m.Url)
</div>
<div class="field">
    @Html.TextBoxFor(m => m.Url, new { @class = "inputtext w230" })
</div>
<div class="labelNoneBorder">
    @Html.LabelFor(m => m.FunctionId)
</div>
<div class="fieldNoneBorder">
    <select id="FunctionId" name="FunctionId">
        @foreach (Function function in ViewBag.FunctionList)
        {
            <option value='@function.Id' @(function.Id == Model.FunctionId ? "selected=selected" : "") @(function.Parent != null ? "class=sub" : "")>@function.Name</option>
        }
    </select>
</div>
<div class="labelNoneBorder">
    @Html.LabelFor(m => m.ParentId)
</div>
<div class="fieldNoneBorder">
    @Html.DropDownListFor(m => m.ParentId, (IEnumerable<SelectListItem>)ViewBag.MenuSelectList)
</div>
<div class="label">
    @Html.LabelFor(m => m.DisplayOrder)
</div>
<div class="field">
    @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "inputtext" })
</div>