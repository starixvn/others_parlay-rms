@using ParlayRMS.Models.Groups
@{
    var groupId = Convert.ToInt32(Session["groupId"]);
}
<div class="searchbar">
    <div class="searchbar-group">
        @Html.Label("UserName", ViewLang.Username)
        @Html.TextBox("UserName", string.Empty, new { @class = "searchbar-input w250" })
    </div>
    <div class="searchbar-group">
        <div class="ui-widget">
            <select id="SearchOption">
                <option value="0">@ViewLang.AllGroups</option>
                @foreach (Group group in ViewBag.GroupList)
                {
                    var selected = "";
                    if (groupId == group.Id)
                    {
                        selected = "selected=\"true\"";
                    }
                    <option value="@group.Id" @selected>@group.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="searchbar-group">
        <button id="userSearch" class="searchbar-button" onclick="Search_onclick('UserName','SearchOption');">
            @ViewLang.Search
        </button>
    </div>
    <div class="searchbar-statistic">
        <div class="searchbar-statistic-active">
            @Html.Label("ActiveUser", ViewLang.ActiveUser) : <span id="activeNumber"></span>
        </div>
        <div class="searchbar-statistic-inactive">
            @Html.Label("InActiveUser", ViewLang.InactiveUser) : <span id="inactiveNumber"></span>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $('#UserName').keypress(function (event) {
            if (event.keyCode == 13) {
                Search_onclick('UserName', 'SearchOption');
            }
        });

        $("#SearchOption").combobox();
        $("#userSearch").button();
    });
</script>