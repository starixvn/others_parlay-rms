@model ParlayRMS.ViewModel.ManageUser.EditUserModel
@{
    Layout = "~/Views/Shared/_PopupLayout.cshtml";
    ViewBag.Title = ViewLang.EditUserInfo;
    ViewBag.Submit = string.Format("EditUserPost({0})", Model.UserId);
}
<div class="popup-content-label2">
    @Html.LabelFor(m => m.UserName)
</div>
<div class="popup-content-noinput">
    @Model.UserName
</div>
<div class="popup-content-label">
    @Html.LabelFor(m => m.FirstName)
</div>
<div class="popup-content-input">
    @Html.TextBoxFor(m => m.FirstName, new { @class = "popup-content-textbox w230" })
</div>
<div class="popup-content-label">
    @Html.LabelFor(m => m.LastName)
</div>
<div class="popup-content-input">
    @Html.TextBoxFor(m => m.LastName, new { @class = "popup-content-textbox w230" })
</div>
<div class="popup-content-label2">
    @Html.LabelFor(m => m.GroupId)
</div>
<div class="popup-content-input2">
    @Html.DropDownListFor(m => m.GroupId, (IEnumerable<SelectListItem>)ViewBag.GroupList, new { @class = "popup-content-select w230" })
</div>