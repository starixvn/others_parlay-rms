@model ParlayRMS.ViewModel.ManageUser.EditUserModel
<div class="boxMain">
    <div class="container">
        <div class="content">
            <div class="allField">
                <div class="title">
                    @ViewLang.EditUserInfo
                </div>
                <div class="lineTop">
                </div>
                <div class="lineBottom">
                </div>
                <div class="labelNoneBorder">
                    @Html.LabelFor(m => m.UserName, ViewLang.Username)
                </div>
                <div class="fieldNoneBorder">
                    @Model.UserName
                </div>
                <div class="label">
                    @Html.LabelFor(m => m.FirstName, ViewLang.Firstname)
                </div>
                <div class="field">
                    @Html.TextBoxFor(m => m.FirstName, new { @class = "inputtext w330" })
                </div>
                <div class="label">
                    @Html.LabelFor(m => m.LastName, ViewLang.Lastname)
                </div>
                <div class="field">
                    @Html.TextBoxFor(m => m.LastName, new { @class = "inputtext w330" })
                </div>
                <div class="labelNoneBorder">
                    @Html.LabelFor(m => m.GroupName, ViewLang.GroupName)
                </div>
                <div class="fieldNoneBorder">
                    @Html.DropDownListFor(m => m.GroupName, (IEnumerable<SelectListItem>)ViewBag.GroupList, new { @class = "w330" })
                </div>
                <div class="actionbar">
                    <div class="actionbar-line">
                        @Html.Action("_LoadingInPopUp", "Shared")
                        <div id="errMsg" class="warningmsg">
                        </div>
                        <div class="button-action">
                            <button id="btnSubmit" onclick="javascript:EditUserPost(@Model.UserId)">
                                <span class="text">@ViewLang.Submit</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
        $(function () {
            $('#GroupName').val(@Model.GroupId);
             $("#btnSubmit").addClass("button");
        });
</script>
