@model ParlayRMS.ViewModel.ManageUser.ResetPasswordModel
<div class="boxMain">
    <div class="container">
        <div class="content">
            <div class="allField">
                <div class="title">
                    Reset Password
                </div>
                <div class="lineTop">
                </div>
                <div class="lineBottom">
                </div>
                <div class="labelNoneBorder">
                    @Html.DisplayNameFor(m => m.UserName)
                </div>
                <div class="fieldNoneBorder">
                    @Html.DisplayTextFor(m => m.UserName)
                </div>
                <div class="label">
                    @Html.LabelFor(m => m.NewPassword)
                </div>
                <div class="field">
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "inputtext w230" })
                </div>
                <div class="label">
                    @Html.LabelFor(m => m.ConfirmPassword)
                </div>
                <div class="field">
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "inputtext w230" })
                </div>
                <div class="actionbar">
                    <div class="actionbar-line">
                        @Html.Action("_LoadingInPopUp", "Shared")
                        <div id="errMsg" class="warningmsg">
                        </div>
                        <div class="button-action">
                            <button id="btnSubmit" onclick="javascript:ResetPasswordPost(@Model.UserId)">
                                <span class="text">@ViewLang.Submit</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $("#btnSubmit").addClass("button");
    });
</script>
