@model ParlayRMS.ViewModel.ManageUser.ResetPasswordModel
@{
    Layout = "~/Views/Shared/_PopupLayout.cshtml";
    ViewBag.Title = ViewLang.ResetPassword;
    ViewBag.Submit = string.Format("ResetPasswordPost({0})", Model.UserId);
}
<div class="labelNoneBorder">
    @Html.DisplayNameFor(m => m.UserName)
</div>
<div class="fieldNoneBorder">
    @Html.DisplayTextFor(m => m.UserName)
</div>
<div class="label">
    @Html.LabelFor(m => m.NewPassword)
</div>
<div class="field">
    @Html.PasswordFor(m => m.NewPassword, new { @class = "inputtext w230" })
</div>
<div class="label">
    @Html.LabelFor(m => m.ConfirmPassword)
</div>
<div class="field">
    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "inputtext w230" })
</div>