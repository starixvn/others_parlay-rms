@model ParlayRMS.ViewModel.ManageUser.CreateUserModel
@{
    Layout = "~/Views/Shared/_PopupLayout.cshtml";
    ViewBag.Title = ViewLang.NewUser;
    ViewBag.Submit = "CreateUserPost()";
}
<div class="label">
    @Html.LabelFor(m => m.UserName, ViewLang.Username)
</div>
<div class="field">
    @Html.TextBoxFor(m => m.UserName, new { @class = "inputtext w230" })
</div>
<div class="label">
    @Html.LabelFor(m => m.Password, ViewLang.Password)
</div>
<div class="field">
    @Html.PasswordFor(m => m.Password, new { @class = "inputtext w230" })
</div>
<div class="label">
    @Html.LabelFor(m => m.FirstName, ViewLang.Firstname)
</div>
<div class="field">
    @Html.TextBoxFor(m => m.FirstName, new { @class = "inputtext w230" })
</div>
<div class="label">
    @Html.LabelFor(m => m.LastName, ViewLang.Lastname)
</div>
<div class="field">
    @Html.TextBoxFor(m => m.LastName, new { @class = "inputtext w230" })
</div>
<div class="labelNoneBorder">
    @Html.LabelFor(m => m.GroupName, ViewLang.GroupName)
</div>
<div class="fieldNoneBorder">
    @Html.DropDownListFor(m => m.GroupName, (IEnumerable<SelectListItem>)ViewBag.GroupList, new { @class = "w230" })
</div>