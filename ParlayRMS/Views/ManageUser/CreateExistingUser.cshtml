@model ParlayRMS.ViewModel.ManageUser.CreateExistingUserModel
@{
    Layout = "~/Views/Shared/_PopupLayout.cshtml";
    ViewBag.Title = ViewLang.ExistingUser;
    ViewBag.Submit = "CreateExistingUserPost()";
}
<div class="popup-content-label">
    @Html.LabelFor(m => m.UserName, ViewLang.Username)
</div>
<div class="popup-content-input">
    @Html.TextBoxFor(m => m.UserName, new { @class = "popup-content-textbox w230" })
</div>
<div class="popup-content-label2">
    @Html.LabelFor(m => m.GroupName, ViewLang.GroupName)
</div>
<div class="popup-content-input2">
    @Html.DropDownListFor(m => m.GroupName, (IEnumerable<SelectListItem>)ViewBag.GroupList, new { @class = "popup-content-select w230" })
</div>