@model ParlayRMS.ViewModel.ManageUser.CreateExistingUserModel
@{
    Layout = "~/Views/Shared/_PopupLayout.cshtml";
    ViewBag.Title = ViewLang.ExistingUser;
    ViewBag.Submit = "CreateExistingUserPost()";
}
<div class="label">
    @Html.LabelFor(m => m.UserName, ViewLang.Username)
</div>
<div class="field">
    @Html.TextBoxFor(m => m.UserName, new { @class = "inputtext w215" })
</div>
<div class="labelNoneBorder">
    @Html.LabelFor(m => m.GroupName, ViewLang.GroupName)
</div>
<div class="fieldNoneBorder">
    @Html.DropDownListFor(m => m.GroupName, (IEnumerable<SelectListItem>)ViewBag.GroupList, new { @class = "textbox w230" })
</div>