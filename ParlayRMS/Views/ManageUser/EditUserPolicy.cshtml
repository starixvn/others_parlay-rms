@model ParlayRMS.ViewModel.ManageUser.EditUserPolicyModel
@{
    Layout = "~/Views/Shared/_PopupLayout.cshtml";
    ViewBag.Submit = string.Format("EditUserPolicyPost({0})", Model.UserId);
}
@section Title
{
    @ViewLang.GrantPermission: <span style="color: #ff6300">@Model.UserName</span>
}
<table id="tblFunction" class="popup-content-table">
    <tr>
        <th rowspan="2">
            @ViewLang.Functions
        </th>
        <th colspan="2">
            @ViewLang.UserPermission
        </th>
        <th colspan="2">
            @ViewLang.GroupPermission
        </th>
    </tr>
    <tr>
        <th>
            @ViewLang.Read
        </th>
        <th>
            @ViewLang.Write
        </th>
        <th>
            @ViewLang.Read
        </th>
        <th>
            @ViewLang.Write
        </th>
    </tr>
    @foreach (var fn in ViewBag.UserFunc)
    {
        var activeR = "inactive";
        var activeW = "inactive";
        var val = "0";

        var activeGroupR = "inactive";
        var activeGroupW = "inactive";

        if (fn.UserPolicy != null)
        {
            if (fn.UserPolicy.Writable)
            {
                activeR = activeW = "active";
                val = "2";
            }
            else if (fn.UserPolicy.Readable)
            {
                activeR = "active";
                activeW = "inactive";
                val = "1";
            }
            else
            {
                activeR = activeW = "inactive";
            }
        }

        if (fn.GroupPolicy != null)
        {
            if (fn.GroupPolicy.Writable)
            {
                activeGroupR = activeGroupW = "active";
            }
            else if (fn.GroupPolicy.Readable)
            {
                activeGroupR = "active";
                activeGroupW = "inactive";
            }
            else
            {
                activeGroupR = activeGroupW = "inactive";
            }
        }

        <tr>
            <td>
                <span class="function">@fn.Name</span>
            </td>
            <td>
                <div id="r-@fn.Id" class="@activeR" parent="r-@fn.Id" permission="1" onclick="grantPermissionsRead(this);">
                </div>
            </td>
            <td>
                <div id="w-@fn.Id" class="@activeW" parent="w-@fn.Id" val="@val" permission="2" onclick="grantPermissionsWrite(this);">
                </div>
            </td>
            <td style="background-color: #dbdbdb">
                <div class="@activeGroupR" style="cursor: default" >
                </div>
            </td>
            <td style="background-color: #dbdbdb">
                <div class="@activeGroupW" style="cursor: default" >
                </div>
            </td>
        </tr>
        foreach (var subfn in ViewBag.UserSubFunc)
        {
            if (fn.Id == subfn.Parent.Id)
            {
                var SubactiveR = "inactive";
                var SubactiveW = "inactive";
                var Subval = "0";

                var SubactiveGroupR = "inactive";
                var SubactiveGroupW = "inactive";

                if (subfn.UserPolicy != null)
                {
                    if (subfn.UserPolicy.Writable)
                    {
                        SubactiveR = SubactiveW = "active";
                        Subval = "2";
                    }
                    else if (subfn.UserPolicy.Readable)
                    {
                        SubactiveR = "active";
                        SubactiveW = "inactive";
                        Subval = "1";
                    }
                    else
                    {
                        SubactiveR = SubactiveW = "inactive";
                    }
                }

                if (subfn.GroupPolicy != null)
                {
                    if (subfn.GroupPolicy.Writable)
                    {
                        SubactiveGroupR = SubactiveGroupW = "active";
                    }
                    else if (subfn.GroupPolicy.Readable)
                    {
                        SubactiveGroupR = "active";
                        SubactiveGroupW = "inactive";
                    }
                    else
                    {
                        SubactiveGroupR = SubactiveGroupW = "inactive";
                    }
                }
        <tr>
            <td>
                <span class="subfunction">- @subfn.Name</span>
            </td>
            <td>
                <div id="r-@subfn.Id" parent="r-@subfn.Parent.Id" permission="1" class="@SubactiveR" onclick="grantPermissions(this);">
                </div>
            </td>
            <td>
                <div id="w-@subfn.Id" parent="w-@subfn.Parent.Id" val="@Subval"  permission="2" class="@SubactiveW" onclick="grantPermissions(this);">
                </div>
            </td>
            <td style="background-color: #dbdbdb">
                <div class="@SubactiveGroupR" style="cursor: default" >
                </div>
            </td>
            <td style="background-color: #dbdbdb">
                <div class="@SubactiveGroupW" style="cursor: default" >
                </div>
            </td>
        </tr>
            }
        }
    }
</table>
