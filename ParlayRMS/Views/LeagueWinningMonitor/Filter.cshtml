@using Formatter = ParlayRMS.Utility.Formatter
<div class="filter">
    <div class="filter-control" style="border: 1px solid black; width: 100%;">
        <div class="minimizetitle">
            <div class="minimizecontent">
                @ViewLang.FilterControl
            </div>
            <div id="filterminimize" class="minimize" onclick="Minimize('filtercontent','filterminimize');">
                -
            </div>
        </div>
        <div id="filtercontent" class="container">
            <div>
                <table>
                    <tbody>
                        <tr>
                            <td style="width: 30px">
                                @Html.Label("", ViewLang.Combo, new { @class = "lable" })
                            </td>
                            <td style="width: 100px">
                                @Html.DropDownList("ddlCombo", (List<SelectListItem>)ViewBag.Combos, new { multiple = "multiple" })
                            </td>
                            <td style="width: 90px">
                                @Html.Label("", ViewLang.ParlayType, new { @class = "lable" })
                            </td>
                            <td style="width: 150px">
                                @Html.DropDownList("ddlParlayType", (List<SelectListItem>)ViewBag.ParlayTypes, new { multiple = "multiple" })
                            </td>
                            <td>
                                @Html.Label("", ViewLang.SportsType, new { @class = "lable" })
                            </td>
                            <td id="fullSportDiv">
                                @RazorHelper.SportTypesDropDown()
                            </td>
                            <td id="someSportDiv">
                                <select id="sportsType" multiple="multiple" name="sportsType">
                                    <option value="1" selected="selected">Soccer only</option>
                                    <option value="-3" selected="selected">Combined sports</option>
                                    <option value="2" selected="selected">Basketball</option>
                                </select>
                            </td>
                            <td style="width: 30px">
                                @Html.Label("", ViewLang.Group, new { @class = "lable" })
                            </td>
                            <td style="width: 100px">
                                @Html.DropDownList("ddlGroup", (List<SelectListItem>)ViewBag.Groups)
                            </td>
                            <td style="width: 5px"></td>
                            <td>
                                @Html.TextBox("txtWinningAmount", Formatter.FormatNumber3(30000), new { @maxlength = 12 })
                            </td>
                            <td><label>(RM)</label></td>
                            <td>
                                @Html.Label("", ViewLang.ReportBy, new { @class = "lable" })
                            </td>
                            <td style="width: 85px">
                                <input type="radio" id="radLeague" checked="checked" name="radReportBy"
                                       value="1">
                                @Html.Label("radLeague", "League", new { @class = "lable" })
                            </td>
                            <td style="width: 100px">
                                <input type="radio" id="radUsername" name="radReportBy" value="2">
                                @Html.Label("radUsername", "Username", new { @class = "lable" })
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.Label("", @ViewLang.Level, new { @class = "lable" })
                            </td>
                            <td>
                                @Html.DropDownList("ddlLevel", (List<SelectListItem>)ViewBag.Levels)
                            </td>
                            <td>
                                @Html.Label("", @ViewLang.SelectTop, new { @class = "lable" })
                            </td>
                            <td>
                                @Html.DropDownList("ddlSelectTop", (List<SelectListItem>)ViewBag.SelectTops)
                            </td>
                            <td>
                                @Html.Label("", @ViewLang.Refreshtime, new { @class = "lable" })
                            </td>
                            <td colspan="2">
                                @Html.DropDownList("ddlRefreshTime", (List<SelectListItem>)ViewBag.RefreshTimes) @ViewLang.Seconds
                            </td>
                            <td colspan="2">
                                <div id="refreshNow" style="width: 140px">
                                    @ViewLang.RefreshNow
                                    <div id="timer" style="float: right; width: 30px; padding-left: 2px;">
                                        [60]
                                    </div>
                                </div>
                            </td>
                            <td>
                                @Html.CheckBox("chkPause", new { style = "float:left; margin-top: 7px;" })
                                @Html.Label("", @ViewLang.Pause, new { @class = "lable" })
                            </td>
                            <td>
                                <button id="submit" class="button" style="float:right">
                                    <span class="text">@ViewLang.Submit</span>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>