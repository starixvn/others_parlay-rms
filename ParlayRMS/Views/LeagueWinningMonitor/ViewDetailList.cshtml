@using ParlayRMS.DTO.LeagueWinningMonitor
@model IEnumerable<RmsRptLeagueWinningMonitorDetail>
<div class="details">
    <table class="sub" style="width: 100%">
        <colgroup>
            <col style="width: 50px" />
            <col style="width: 150px" />
            <col style="width: 100px" />
            <col style="width: 100px" />
            <col style="width: 50px" />
            <col style="width: 70px" />
            <col style="width: 100px" />
            <col style="width: 100px" />
            <col style="width: 100px" />
            <col style="width: 100px" />
            <col style="width: 80px" />
            <col style="width: 80px" />
            <col style="width: 80px" />
            <col style="width: 100px" />
            <col style="width: 80px" />
        </colgroup>
        <thead>
            <tr>
                <th>No</th>
                <th>Trans. Time</th>
                <th>BetID</th>
                <th>User Name</th>
                <th>Level</th>
                <th>Odds</th>
                <th>Member Stake</th>
                <th>Winning Amount</th>
                <th>Net Win After PT</th>
                <th>Company Lose Amount</th>
                <th>Total Combo Bets</th>
                <th>Total Selection</th>
                <th>Sport Type</th>
                <th>IP</th>
                <th>Bet Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Select((val, ind) => new { Val = val, Ind = ind + 1 }))
            {
                <tr>
                    <td class="center">
                        @item.Ind
                    </td>
                    <td class="center">
                        @item.Val.TransDate
                    </td>
                    <td class="numeric">
                        <a href="#" onclick="window.open(resolveClientUrl('SimilarBets?betid=@item.Val.TransId'), '_blank');">@item.Val.TransId</a>
                    </td>
                    <td class="left">
                        @item.Val.Username
                    </td>
                    <td>
                        @item.Val.Level
                    </td>
                    <td class="numeric">
                        @Formatter.FormatOdds(item.Val.Odds)
                    </td>
                    <td class="numeric">
                        @Formatter.FormatOdds(item.Val.Stake)
                    </td>
                    <td class="numeric">
                        @Formatter.FormatWithoutRounding(item.Val.WinningAmount)
                    </td>
                    <td class="numeric">
                        @Formatter.FormatWithoutRounding(item.Val.NetWinAfterPT)
                    </td>
                    <td class="numeric">
                        @Formatter.FormatWithoutRounding(item.Val.CompanyLoseAmount)
                    </td>
                    <td class="center">
                        @item.Val.Combo
                    </td>
                    <td class="center">
                        @item.Val.TotalSelection
                    </td>
                    <td class="center">
                        @item.Val.SportType
                    </td>
                    <td class="numeric">
                        @if (item.Val.IP == null || item.Val.IP == "" || item.Val.IP == "null")
                        {
                            <span>----</span>
                        }
                        else
                        {
                            <a href="#" onclick="window.open(resolveClientUrl('ViewIPInfo?ip=@item.Val.IP&date=@item.Val.TransDate'), '_blank');">@item.Val.IP</a>
                        }
                    </td>
                    <td>

                        <button class="button-disable-2" style="width:40px;" onclick="ViewBetDetails('@item.Val.Username',@item.Val.TransId, @item.Val.RefNo, @item.Val.BetType, @item.Val.CustId);">
                            View
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>