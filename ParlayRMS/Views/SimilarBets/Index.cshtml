@{
    ViewBag.Title = ViewBag.HeaderText = ViewLang.SimilarBets;
}
<div class="filter">
    <div class="filter-control" style="width: 400px">
        <div class="minimizetitle">
            <div class="minimizecontent">
                @ViewLang.FilterControl
            </div>
            <div id="filterminimize" class="minimize" onclick="Minimize('filtercontent','filterminimize');">
                -
            </div>
        </div>
        <div id="filtercontent" class="container">
            <div class="group">
                @Html.Label("betId", "BetID")
                @Html.TextBox("betId", (string)ViewBag.betid)
            </div>
            <div class="group">
                @Html.CheckBox("similar", new { style = "float:left; margin-top: 7px;" })
                @Html.Label("similar", "Similar 100%", new { @class = "lable" })
            </div>
            <div class="group">
                <button id="btnSearch">
                    <span class="text">@ViewLang.Submit</span>
                </button>
            </div>
        </div>
    </div>
</div>
<div style="clear: both; display: none" id="divResult">
</div>
@Scripts.Render("~/Scripts/Member/Core/js")
@Scripts.Render("~/Scripts/Report/SimilarBets/js")