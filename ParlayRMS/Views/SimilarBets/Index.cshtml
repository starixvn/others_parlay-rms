@{
    ViewBag.Title = ViewBag.HeaderText = ViewLang.SimilarBets;
}
<div class="filter">
    <div class="filter-control" style="width: 310px">
        <div class="minimizetitle">
            <div class="minimizecontent">
                @ViewLang.FilterControl</div>
            <div id="filterminimize" class="minimize" onclick="Minimize('filtercontent','filterminimize');">
                -
            </div>
        </div>
        <div id="filtercontent" class="container">
            <div class="group">
                @Html.Label("betId", "BetID")
                @Html.TextBox("betId", (string)ViewBag.betid)
            </div>
            <div class="group">
                <button id="btnSearch">
                    <span class="text">@ViewLang.Submit</span>
                </button>
            </div>
        </div>
    </div>
</div>
<div style="clear: both; display: none" id="divResult">
</div>
<script src="@Url.Content("~/Scripts/Libs/sortElements/jquery.sortElements.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Member/Core.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/Report/SimilarBets.js")" type="text/javascript"></script>