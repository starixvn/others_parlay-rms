@model ParlayRMS.ViewModel.Report.BetDetails
@{
    Layout = null;
    ViewBag.Title = ViewBag.HeaderText = ViewLang.TicketDetails;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta content="text/html" charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link rel="stylesheet" type="text/css" href="http://fonts.googleapis.com/css?family=Abel" />
    @Styles.Render("~/Content/Libs/jquery-ui/themes/base/css")
    @Styles.Render("~/Content/Libs/css")
    @Styles.Render("~/Content/css")
    <meta name="viewport" content="width=device-width" />
</head>
<body>
    <div style="text-align: left; margin-left: auto; margin-right: auto; overflow: hidden">
        <div style="float: left; left: 50%; position: relative">
            <div class="boxMain" style="float: left; position: relative; right: 50%;">
                <div class="content" style="min-height: 0px">
                    <div class="allField2">
                        <div class="title2">
                            @ViewLang.TicketDetails - @ViewBag.Username - @ViewBag.BetId
                        </div>
                        <div class="betdetails">
                            @Html.Raw(Model.TicketDetail)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>