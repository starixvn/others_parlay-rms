@using ParlayRMS.Web.Mvc
@{
    ViewBag.Title = ViewBag.HeaderText = ViewLang.TopWinners;
}
<div class="filter">
    <div class="filter-control" style="width: 980px">
        <div class="minimizetitle">
            <div class="minimizecontent">
                @ViewLang.FilterControl</div>
            <div id="filterminimize" class="minimize" onclick="Minimize('filtercontent','filterminimize');">
                -
            </div>
        </div>
        <div id="filtercontent" class="container">
            <div class="row">
                <div class="group">
                    @Html.Label("selectTop", ViewLang.SelectTop)
                    @Html.DropDownList("selectTop", (IEnumerable<SelectListItem>)ViewBag.SelectTops)
                </div>
                <div class="group">
                    @Html.Label("dateRange", ViewLang.DateRange)
                    @Html.DropDownList("dateRange", Config.DateRanges)
                </div>
                <div class="group">
                    @Html.Label("", ViewLang.From)
                    @Html.TextBox("fromDate")
                </div>
                <div class="group">
                    @Html.Label("", ViewLang.To)
                    @Html.TextBox("toDate")
                </div>
                <div class="group">
                    <button id="btnSearch">
                        <span class="text">@ViewLang.Submit</span>
                    </button>
                </div>
            </div>
            <div class="row">
                <div class="group">
                    @Html.Label(ViewLang.Combo)
                    @Html.DropDownList("combo", Config.Combos)
                </div>
                <div class="group">
                    @Html.Label(ViewLang.ParlayType)
                    @Html.DropDownList("parlayType", Config.ParlayTypes)
                </div>
                <div id="divSportsTypes" class="group">
                    @Html.Label(ViewLang.SportsType)
                    @Html.RadioButtonList("SportsTypes", Config.SportsTypes)
                </div>
            </div>
        </div>
    </div>
</div>
<div style="clear: both; display: none" id="divResult">
    <div style="width: 1176px" class="maintitle">
        <div id="title" class="information">
        </div>
        <div class="excel" onclick="ExportExcel();" title="Export Excel">
        </div>
    </div>
    <div style="width: 1176px">
        <table class="main" id="header">
            <colgroup>
                <col width='40px' />
                <col width='140px' />
                <col width='80px' />
                <col width='90px' />
                <col width='120px' />
                <col width='150px' />
                <col width='90px' />
                <col width='135px' />
                <col width='170px' />
                <col width='80px' />
                <col width='80px' />
            </colgroup>
            <thead>
                <tr>
                    <th rowspan="2" class="header2rows">
                        #
                    </th>
                    <th rowspan="2" class="header2rows">
                        @ViewLang.Username
                    </th>
                    <th rowspan="2" class="header2rows">
                        @ViewLang.Currency
                    </th>
                    <th colspan="3">
                        @ViewLang.OriginalCurrency
                    </th>
                    <th colspan="3">
                        @ViewLang.BaseCurrency
                    </th>
                    <th rowspan="2" class="header2rows">
                        @ViewLang.TotalBets
                    </th>
                    <th rowspan="2" class="header2rows">
                        @ViewLang.AverageWinOdds
                    </th>
                </tr>
                <tr>
                    <th>
                        @ViewLang.Stake
                    </th>
                    <th>
                        @ViewLang.WinningAmount
                    </th>
                    <th>
                        @ViewLang.CompanyLoseAmount
                    </th>
                    <th>
                        @ViewLang.Stake
                    </th>
                    <th class="sortable" data-col-type="float" data-col-index="7">
                        @ViewLang.WinningAmount
                    </th>
                    <th class="sortable" data-col-type="float" data-col-index="8">
                        @ViewLang.CompanyLoseAmount
                    </th>
                </tr>
            </thead>
        </table>
    </div>
    <div class="scrollGridContent" style="max-height: 500px; width: 1195px">
        <table class="main" id="result">
            <colgroup>
                <col width='40px' />
                <col width='140px' />
                <col width='80px' />
                <col width='90px' />
                <col width='120px' />
                <col width='150px' />
                <col width='90px' />
                <col width='135px' />
                <col width='170px' />
                <col width='80px' />
                <col width='80px' />
            </colgroup>
            <tbody>
            </tbody>
        </table>
    </div>
    <div style="width: 1176px" class="mainfooter">
        <table class="main" id="footer">
            <colgroup>
                <col width='40px' />
                <col width='140px' />
                <col width='80px' />
                <col width='90px' />
                <col width='120px' />
                <col width='150px' />
                <col width='90px' />
                <col width='135px' />
                <col width='170px' />
                <col width='80px' />
                <col width='80px' />
            </colgroup>
            <tfoot>
                <tr id="totalRow">
                    <td colspan="6" class="right">
                        @ViewLang.Total
                    </td>
                    <td class="numeric" id="totalStake">
                    </td>
                    <td class="numeric" id="totalWA">
                    </td>
                    <td class="numeric" id="totalCLA">
                    </td>
                    <td class="center" id="totalTB">
                    </td>
                    <td style="text-align: center">
                        -
                    </td>
                </tr>
                <tr id="noinfoRow">
                    <td colspan="11" style="text-align: center; width: 1141px">
                        @ViewLang.NoInformation
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
@Scripts.Render("~/Scripts/Report/TopWinners/js")
<script type="text/javascript">
    var dateRanges = {
        Yesterday : @Convert.ToInt32(DateRange.Yesterday),
        CurrentWeek : @Convert.ToInt32(DateRange.CurrentWeek),
        CurrentMonth : @Convert.ToInt32(DateRange.CurrentMonth),
        LastWeek : @Convert.ToInt32(DateRange.LastWeek),
        LastMonth : @Convert.ToInt32(DateRange.LastMonth),
        SinceLastMonth : @Convert.ToInt32(DateRange.SinceLastMonth),
        SpecificDate:  @Convert.ToInt32(DateRange.SpecificDate),
        LimitDataFromDate : '@AppSetting.LimitDataFromDate',
        NowDate: '@DateTime.Now'
    };
    var hasWritePermission = @JavascriptHelper.GetString(ViewBag.HasWritePermission);
</script>