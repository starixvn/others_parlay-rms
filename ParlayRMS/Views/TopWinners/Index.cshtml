@{
    ViewBag.Title = ViewBag.HeaderText = ViewLang.TopWinners;
}
@Styles.Render("~/Content/TopWinners")
<div class="filter">
    <div class="filter-control" style="width: 840px">
        <div class="minimizetitle">
            <div class="minimizecontent">
                @ViewLang.FilterControl
            </div>
            <div id="filterminimize" class="minimize" onclick="Minimize('filtercontent','filterminimize');">
                -
            </div>
        </div>
        <div id="filtercontent" class="container">
            <div class="row">
                <div class="group">
                    @Html.Label("selectTop", ViewLang.SelectTop)
                    @Html.DropDownList("selectTop", (IEnumerable<SelectListItem>)ViewBag.SelectTops)
                </div>
                <div class="group">
                    @Html.Label("dateRange", ViewLang.DateRange)
                    @Html.DropDownList("dateRange", Config.DateRanges)
                </div>
                <div class="group">
                    @Html.Label("", ViewLang.From)
                    @Html.TextBox("fromDate")
                </div>
                <div class="group">
                    @Html.Label("", ViewLang.To)
                    @Html.TextBox("toDate")
                </div>
                <div class="group">
                    <button id="btnSearch">
                        <span class="text">@ViewLang.Submit</span>
                    </button>
                </div>
            </div>
            <div class="row">
                <div class="group">
                    @Html.Label(ViewLang.Combo)
                    @Html.DropDownList("combo", Config.Combos)
                </div>
                <div class="group">
                    @Html.Label("", ViewLang.Site)
                    @Html.DropDownList("ddlSite", Config.Sites)
                </div>
                <div class="group">
                    @Html.Label(ViewLang.ParlayType)
                    @Html.DropDownList("parlayType", Config.ParlayTypes)
                </div>
                <div class="group">
                    @Html.Label("", ViewLang.LiveType)
                    @Html.DropDownList("ddlLiveType", Config.LiveTypes)
                </div>
            </div>
            <div class="row">
                <div id="divSportsTypes" class="group">
                    @Html.Label(ViewLang.SportsType)
                    @RazorHelper.SportTypesDropDown()
                </div>
                <div class="group">
                    @Html.Label(ViewLang.Currency)
                    @Html.DropDownList("currencies", (List<SelectListItem>)ViewBag.Currency)
                </div>
                <div class="group">
                    @Html.Label("", ViewLang.CustomerClass)
                    @Html.TextBox("txtCustomerClass", "", new { @class = "inputtext w100", maxlength = "6", onkeypress = "return IsNumber(event)" })
                </div>
            </div>
        </div>
    </div>
</div>
<div style="clear: both; display: none" id="divResult">
    <div style="width: 1555px" class="maintitle">
        <div id="title" class="information">
        </div>
        <div class="excel" onclick="ExportExcel();" title="Export Excel">
        </div>
    </div>
    <div style="width: 1555px ">
        <table class="main" id="header">
            <colgroup>
                <col width='40' />
                <col width='75' />
                <col width='140' />
                <col width='120' />
                <col width='80' />
                <col width='140' />
                <col width='120' />
                <col width='150' />
                <col width='140' />
                <col width='135' />
                <col width='170' />
                <col width='100' />
                <col width='144' />
            </colgroup>
            <thead>
                <tr>
                    <th rowspan="2" class="header2rows">
	                    @ViewLang.No
                    </th>
                    <th rowspan="2" class="header2rows">
                        @ViewLang.Site
                    </th>
                    <th rowspan="2" class="header2rows">
                        @ViewLang.Username
                    </th>
                    <th rowspan="2" class="header2rows">
                        @ViewLang.CustomerClass
                    </th>
                    <th rowspan="2" class="header2rows">
                        @ViewLang.Currency
                    </th>
                    <th colspan="3">
                        @ViewLang.OriginalCurrency
                    </th>
                    <th colspan="3">
                        @ViewLang.BaseCurrency
                    </th>
                    <th rowspan="2" class="header2rows">
                        @ViewLang.TotalBets
                    </th>
                    <th rowspan="2" class="header2rows">
                        @ViewLang.AverageWinOdds
                    </th>
                </tr>
                <tr>
                    <th>
                        @ViewLang.Stake
                    </th>
                    <th>
                        @ViewLang.WinningAmount
                    </th>
                    <th>
                        @ViewLang.CompanyLoseAmount
                    </th>
                    <th class="sortable" data-col-type="float" data-col-index="8">
                        @ViewLang.Stake
                    </th>
                    <th class="sortable" data-col-type="float" data-col-index="9">
                        @ViewLang.WinningAmount
                    </th>
                    <th class="sortable" data-col-type="float" data-col-index="10">
                        @ViewLang.CompanyLoseAmount
                    </th>
                </tr>
            </thead>
        </table>
    </div>
    <div class="scrollGridContent" style="max-height: 500px; width: 1575px">
        <table class="main" id="result">
            <colgroup>
                <col width='40' />
                <col width='75' />
                <col width='140' />
                <col width='120' />
                <col width='80' />
                <col width='140' />
                <col width='120' />
                <col width='150' />
                <col width='140' />
                <col width='135' />
                <col width='170' />
                <col width='100' />
                <col width='144' />
            </colgroup>
            <tbody></tbody>
        </table>
    </div>
    <div style="width: 1555px" class="mainfooter">
        <table class="main" id="footer" style="width: 100%">
            <colgroup>
                <col width='40' />
                <col width='75' />
                <col width='140' />
                <col width='120' />
                <col width='80' />
                <col width='140' />
                <col width='120' />
                <col width='150' />
                <col width='140' />
                <col width='135' />
                <col width='170' />
                <col width='100' />
                <col width='144' />
            </colgroup>
            <tfoot>
                <tr id="totalRow">
                    <td colspan="8" class="right">
                        @ViewLang.Total
                    </td>
                    <td class="numeric" id="totalStake"></td>
                    <td class="numeric" id="totalWA"></td>
                    <td class="numeric" id="totalCLA"></td>
                    <td class="center" id="totalTB"></td>
                    <td style="text-align: center">
                        -
                    </td>
                </tr>
                <tr id="noinfoRow">
                    <td colspan="13" style="text-align: center">
                        @ViewLang.NoInformation
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
@Scripts.Render("~/Scripts/Report/TopWinners/js?v=3")
<script type="text/javascript">
    var dateRanges = {
        Yesterday : @Convert.ToInt32(DateRange.Yesterday),
        CurrentWeek : @Convert.ToInt32(DateRange.CurrentWeek),
        CurrentMonth : @Convert.ToInt32(DateRange.CurrentMonth),
        LastWeek : @Convert.ToInt32(DateRange.LastWeek),
        LastMonth : @Convert.ToInt32(DateRange.LastMonth),
        SinceLastMonth : @Convert.ToInt32(DateRange.SinceLastMonth),
        SpecificDate:  @Convert.ToInt32(DateRange.SpecificDate),
        LimitDataFromDate : '@AppSetting.LimitDataFromDate',
        NowDate: '@DateTime.Now'
    };
    var hasWritePermission = @JavascriptHelper.GetString(ViewBag.HasWritePermission);
</script>