@{
    var SportName = String.Empty;
    if (ViewBag.SportType == (int)SportsType.SoccerOnly)
    {
        SportName = ViewLang.Socceronly;
    }
    else
    {
        SportName = ViewLang.Others;
    }
    ViewBag.Title = ViewBag.HeaderText = SportName + " bet list - " + ViewBag.UserName;
    int counter = 0;
    Decimal TotalWinLoss = 0;
}
@model IEnumerable<ParlayRMS.DTO.ViewIPInfo.RMS_Rpt_Parlay_ViewIPInfoByUser>
<div style="clear: both; id="divResult">
    <div style="width: 990px">
        <table class="main" id="header">
            <colgroup>
                <col width='100px' />
                <col width='150px' />
                <col width='250px' />
                <col width='120px' />
                <col width='120px' />
                <col width='120px' />
                <col width='120px' />
            </colgroup>
            <thead>
                <tr>
                    <th>
                        @ViewLang.No
                    </th>
                   <th>
                        @ViewLang.TransTime
                    </th>
                    <th>
                        @ViewLang.Choice
                    </th>
                    <th>
                        @ViewLang.Odds
                    </th>
                    <th>
                        @ViewLang.Stake
                    </th>
                    <th>
                        @ViewLang.WinLoss
                    </th>
                    <th>
                        @ViewLang.Status
                    </th>
                </tr>
            </thead>
        </table>
    </div>
    <div class="scrollGridContent" style="max-height: 780px; width: 1000px">
        <table class="main" id="result">
            <colgroup>
                <col width='100px' />
                <col width='150px' />
                <col width='250px' />
                <col width='120px' />
                <col width='120px' />
                <col width='120px' />
                <col width='120px' />
            </colgroup>
            <tbody>
                @foreach (var item in Model)
                {
                    var ComboName = "";
                    counter = counter + 1;
                    <tr>
                        <td class="center">
                            @counter
                        </td>
                        <td class="numeric">
                            <div style="font-weight: bold">
                                Ref No: @item.RefNo
                            </div>
                            <div>
                                @item.TransDate
                            </div>
                        </td>
                        <td class="choice right">
                            <a href="#" class="tdChoice" data-id="@item.RefNo">
                                    @if (item.BetType == (int)BetType.MixParlay)
                                    {
                                        @ViewLang.MixparLay;
                                    }
                                    else if (item.BetType == (int)BetType.SystemParlay)
                                    {
                                        switch ((SystemParlayCombo)item.Combo)
                                        {
                                            case SystemParlayCombo.Trixie:
                                                ComboName = ViewLang.Trixie;
                                                break;

                                            case SystemParlayCombo.Yankee:
                                                ComboName = ViewLang.Yankee;
                                                break;

                                            case SystemParlayCombo.Canadian:
                                                ComboName = ViewLang.Canadian;
                                                break;

                                            case SystemParlayCombo.Heinz:
                                                ComboName = ViewLang.Heinz;
                                                break;

                                            case SystemParlayCombo.SuperHeinz:
                                                ComboName = ViewLang.SuperHeinz;
                                                break;

                                            case SystemParlayCombo.Goliath:
                                                ComboName = ViewLang.Goliath;
                                                break;
                                        }
                                        @(ViewLang.SystemparLay + " - " + ComboName)
                                    }
                            </a>
                            @if (item.BetType == (int)BetType.SystemParlay)
                            {
                                <div class="tdDetail">
                                    <a class="tdDetailLink" data-id="@item.RefNo" data-combo="@ComboName" href="#">@ViewLang.Details</a>
                                </div>
                            }
                            <div style="display:none" class="Expand" id= "exp_@item.RefNo">
                            </div>
                        </td>
                        <td class="numeric">
                            @if (item.StatusId == 0 && item.BetType == (int)BetType.SystemParlay)
                            {
                                @Html.Raw("-")
                            }
                            else
                            {
                                @item.Odds.ToString("#,##0.000")
                            }
                        </td>
                        <td class="numeric">@item.Stake.ToString("#,##0")</td>
                        @{
                            var winlossNegative = item.Winlost < 0 ? "negative" : "";
                         }
                        <td class="numeric @winlossNegative">
                                @if (item.StatusId == 0)
                                {
                                    @Html.Raw("-")
                                }
                                else
                                {
                                    @item.Winlost.ToString("#,##0.00")
                                    TotalWinLoss += @item.Winlost;
                                }
                        </td>

                        <td class="center">
                            @item.Status.ToUpper()
                        </td>
                    </tr>
                }
                @if (counter == 0)
                {
                    <tr><td class="noinfo" colspan="7">No information is available</td></tr>
                }
            </tbody>
        </table>
    </div>
    <table class="main" id="footer">
         <colgroup>
            <col width='100px' />
            <col width='150px' />
            <col width='250px' />
            <col width='120px' />
            <col width='120px' />
            <col width='120px' />
            <col width='120px' />
        </colgroup>
        <tfoot>
            <tr>
                @{var totalNegative = TotalWinLoss < 0 ? "negative" : "";}
                <td colspan=5 class="right">Total</td>
                <td class="numeric  @totalNegative">@TotalWinLoss.ToString("#,##0.00")</td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</div>
@Scripts.Render("~/Scripts/Report/ViewIPInfoByUser/js")
@Scripts.Render("~/Scripts/Member/Core/js")
