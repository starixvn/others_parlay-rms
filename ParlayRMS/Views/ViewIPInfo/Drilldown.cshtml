@{
    var sportName = String.Empty;
    if (ViewBag.SportType == (int)SportsType.SoccerOnly)
    {
        sportName = ViewLang.Socceronly;
    }
    else
    {
        sportName = ViewLang.Others;
    }
    ViewBag.Title = ViewBag.HeaderText = sportName + " bet list - " + ViewBag.UserName;
    int counter = 0;
    decimal totalWinLoss = 0;
}
@model IEnumerable<ParlayRMS.DTO.ViewIPInfo.RMS_Rpt_Parlay_ViewIPInfoByUser>
<div>
    <div style="width: 1040px">
        <table class="main" id="header">
            <colgroup>
                <col width='100px' />
                <col width='150px' />
                <col width='300px' />
                <col width='120px' />
                <col width='120px' />
                <col width='120px' />
                <col width='120px' />
            </colgroup>
            <thead>
                <tr>
                    <th>
                        @ViewLang.No
                    </th>
                    <th>
                        @ViewLang.TransTime
                    </th>
                    <th>
                        @ViewLang.Choice
                    </th>
                    <th>
                        @ViewLang.Odds
                    </th>
                    <th>
                        @ViewLang.Stake
                    </th>
                    <th>
                        @ViewLang.WinLoss
                    </th>
                    <th>
                        @ViewLang.Status
                    </th>
                </tr>
            </thead>
        </table>
    </div>
    <div class="scrollGridContent" style="max-height: 780px; width: 1050px">
        <table class="main" id="result">
            <colgroup>
                <col width='100px' />
                <col width='150px' />
                <col width='300px' />
                <col width='120px' />
                <col width='120px' />
                <col width='120px' />
                <col width='120px' />
            </colgroup>
            <tbody>
                @foreach (var item in Model)
                {
                    var isHideDetails = string.Equals(item.Status, "void", StringComparison.OrdinalIgnoreCase) || string.Equals(item.Status, "reject", StringComparison.OrdinalIgnoreCase);
                    isHideDetails = isHideDetails || item.BetType == 38;
                    counter = counter + 1;
                    <tr>
                        <td class="center">
                            @counter
                        </td>
                        <td class="center">
                            <div style="font-weight: bold">
                                BetID: @item.TransID
                            </div>
                            <div>
                                @item.TransDate.ToString("MM/d/yyyy h:mm:ss t\\M")
                            </div>
                        </td>
                        <td class="choice right">
                            <a href="#" class="tdChoice" data-transid="@item.TransID" data-refno="@item.RefNo" data-bet-type="@item.BetType" data-bet-team="@item.BetTeam" data-bet-check="@item.BetCheck" data-hdp1="@item.Hdp1" data-hdp2="@item.Hdp2">
                                @if (item.BetType == (int)BetType.MixParlay)
                                {
                                    @ViewLang.MixparLay;
                                }
                                else if (item.BetType == (int)BetType.SystemParlay)
                                {
                                    var comboTypes = CacheRef.GetCombinationTypeCombo(item.BetTeam, item.BetCheck, item.Hdp1, item.Hdp2);
                                    if (item.BetTeam == "1")
                                    {
                                        @ViewLang.MixparLay
                                    }
                                    else
                                    {
                                        @ViewLang.SystemparLay
                                    }
                                    if (comboTypes != null)
                                    {
                                        <div class="combo-type">
                                            @foreach (var comboType in comboTypes)
                                            {
                                                <p class="underdog">@comboType</p>
                                            }
                                        </div>
                                    }
                                }
                            </a>
                            @if (item.BetType == (int)BetType.SingleMatchParlay)
                            {
                                <br />
                                @Html.Raw(item.Choice)
                            }
                            @if (!isHideDetails)
                            {
                                <div class="tdDetail">
                                    <a class="tdDetailLink" data-transid="@item.TransID" data-refno="@item.RefNo" data-bet-type="@item.BetType" data-bet-team="@item.BetTeam" href="#">@ViewLang.Details</a>
                                </div>
                            }
                            <div style="display:none" class="Expand" id="exp_@item.RefNo">
                            </div>
                        </td>
                        <td class="numeric">
                            @if (item.BetType == (int)BetType.SystemParlay)
                            {
                                @Html.Raw("-")
                            }
                            else
                            {
                                @item.Odds.ToString("#,##0.000")
                            }
                        </td>
                        <td class="numeric">@item.Stake.ToString("#,##0")</td>
                        @{
                            var winLossNegative = (item.Winlost < 0 && item.StatusId != 0) ? "negative" : "";
                        }
                        <td class="numeric @winLossNegative">
                            @if (item.StatusId == 0)
                            {
                                @Html.Raw("-")
                            }
                            else
                            {
                                @item.Winlost.ToString("#,##0.00")
                                totalWinLoss += @item.Winlost;
                            }
                        </td>

                        <td class="center">
                            @item.Status.ToUpper()
                        </td>
                    </tr>
                            }
                @if (counter == 0)
                {
                    <tr><td class="noinfo" colspan="7">@ViewLang.NoInformation</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (counter != 0)
    {
        <div style="width: 1031px" id="divResult" class="separateFooter">
            <table class="total" id="footer">
                <colgroup>
                    <col width='100px' />
                    <col width='150px' />
                    <col width='300px' />
                    <col width='120px' />
                    <col width='120px' />
                    <col width='120px' />
                    <col width='120px' />
                </colgroup>
                <tfoot>
                    <tr>
                        <td colspan=5 class="right">Total</td>
                        <td class="numeric">@totalWinLoss.ToString("#,##0.00")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>
@Scripts.Render("~/Scripts/Report/ViewIPInfoByUser/js")
@Scripts.Render("~/Scripts/Member/Core/js")