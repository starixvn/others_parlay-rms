@Styles.Render("~/Content/ViewIPInfo")
<div id="tabs">
    <ul>
        <li><a href="#tabs-ip-statistics" style="font-weight: bold">@ViewLang.IPStatistics</a></li>
        <li><a href="#tabs-view-ip-info" style="font-weight: bold">@ViewLang.IPInfo</a></li>
    </ul>
    <div id="tabs-ip-statistics" style="display: inline-block">
        <div class="filter">
            <div class="filter-control" style="width: 505px">
                <div class="minimizetitle">
                    <div class="minimizecontent">
                        @ViewLang.FilterControl
                    </div>
                    <div id="filterminimize-ip-stats" class="minimize" onclick="Minimize('filtercontent-ip-stats','filterminimize-ip-stats');">
                        -
                    </div>
                </div>
                <div id="filtercontent-ip-stats" class="container">
                    <div class="row">
	                    <div class="group">
		                    @Html.Label("", ViewLang.Date + ":")
		                    @Html.TextBox("date-ipstats")
	                    </div>
	                    <div class="group">
		                    @Html.Label("", ViewLang.TicketStatus + ":")
		                    @Html.DropDownList("ticketStatus-ipstats", Config.TicketStatus, new { multiple = "multiple" })
	                    </div>
                        <div class="group">
                            <button id="btnSearchIPStats">
                                <span class="text">@ViewLang.Submit</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div style="clear: both; display: none" id="divResultIpStats">
        </div>
    </div>
    <div id="tabs-view-ip-info" style="display: inline-block">
        <div class="filter">
            <div class="filter-control" style="width: 915px">
                <div class="minimizetitle">
                    <div class="minimizecontent">
                        @ViewLang.FilterControl
                    </div>
                    <div id="filterminimize-ip-info" class="minimize" onclick="Minimize('filtercontent-ip-info','filterminimize-ip-info');">
                        -
                    </div>
                </div>
                <div id="filtercontent-ip-info" class="container">
                    <div class="row">
                        <div class="group ipInput">
                            @Html.Label("ip", ViewLang.IP + ":")
                            @Html.TextBox("ip")
                        </div>
	                    <div class="group">
		                    @Html.Label("", ViewLang.Date + ":")
		                    @Html.TextBox("date-ipinfo")
	                    </div>
                        <div class="group">
                            @Html.Label("", ViewLang.TicketStatus + ":")
                            @Html.DropDownList("ticketStatus-ipinfo", Config.TicketStatus, new { multiple = "multiple" })
                        </div>
                        <div class="group">
                            <button id="btnSearchIpInfo">
                                <span class="text">@ViewLang.Submit</span>
                            </button>
                        </div>
                        <div class="group">
                            <a id="ipViewLink" href="#">@ViewLang.ViewIPInfo</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
	    <div style="clear: both; display: none" id="divResultIpInfo">
		    <div style="width: 1345px; height: 30px; background-color: #3f536b">
			    <div class="excel" onclick="ExportExcelForIpInfo();" title="Export Excel">
			    </div>
		    </div>
		    <div style="width: 1365px">
			    <table class="main" id="header">
				    <colgroup>
					    <col width='120'/>
					    <col width='75'/>
					    <col width='150'/>
					    <col width='150'/>
					    <col width='150'/>
					    <col width='150'/>
					    <col width='150px' />
					    <col width='200px' />
					    <col width='200px' />
				    </colgroup>
				    <thead>
				    <tr>
					    <th>
						    @ViewLang.No
					    </th>
					    <th>
						    @ViewLang.Site
					    </th>
					    <th>
						    @ViewLang.Username
					    </th>
					    <th>
						    @ViewLang.Socceronly
					    </th>
					    <th>
						    @ViewLang.Others
					    </th>
					    <th>
						    @ViewLang.Total
					    </th>
					    <th data-col-type="float" class="sortable" data-col-index="6">
						    @ViewLang.Stake
					    </th>
					    <th data-col-type="float" class="sortable" data-col-index="7">
						    @ViewLang.WinningAmount
					    </th>
					    <th data-col-type="float" class="sortable" data-col-index="8">
						    @ViewLang.HouseLoseAmount
					    </th>
				    </tr>
				    </thead>
			    </table>
		    </div>
		    <div class="scrollGridContent" style="max-height: 680px; width: 1345px">
			    <table class="main" id="result-ip-info">
				    <colgroup>
					    <col width='120'/>
					    <col width='75'/>
					    <col width='150'/>
					    <col width='150'/>
					    <col width='150'/>
					    <col width='150'/>
					    <col width='150px' />
					    <col width='200px' />
					    <col width='200px' />
				    </colgroup>
				    <tbody>
				    </tbody>
			    </table>
		    </div>
		    <div style="width: 1345px" class="separateFooter">
			    <table class="total" id="total-footer-ip-info">
				    <colgroup>
					    <col width='120'/>
					    <col width='75'/>
					    <col width='150'/>
					    <col width='150'/>
					    <col width='150'/>
					    <col width='150'/>
					    <col width='150px' />
					    <col width='200px' />
					    <col width='200px' />
				    </colgroup>
				    <tfoot>
				    </tfoot>
			    </table>
		    </div>
	    </div>
    </div>
</div>
<script type="text/javascript">
    var dateOption = {
        NowDate: '@DateTime.Now',
        InputDate: '@ViewBag.date',
        MinDate: '@ViewBag.minDate'
    }
</script>
@Scripts.Render("~/Scripts/Report/ViewIPInfo/js?v=5")
@Scripts.Render("~/Scripts/Member/Core/js")