@{
    Layout = null;
}
@model ParlayRMS.Models.ViewIpInfo.CombinationDetailsByDateViews
<div class="boxMain">
    <div class="container">
        <div class="content">
            <div class="title2">
                    System Parlay -- @ViewBag.ComboType
            </div>
            <div style="margin-left: 12px; margin-bottom: 12px">
            <table class="main" id="header">
                <colgroup>
                    <col width='80px' />
                    <col width='300px' />
                    <col width='80px' />
                    <col width='80px' />
                    <col width='80px' />
                    <col width='70px' />
                </colgroup>
                <thead>
                    <tr>
                        <th>
                            @ViewLang.Date
                        </th>
                        <th>
                            @ViewLang.Event
                        </th>
                        <th>
                            @ViewLang.Odds
                        </th>
                        <th>
                            @ViewLang.Stake
                        </th>
                        <th>
                            @ViewLang.WinLoss
                        </th>
                            <th>
                            @ViewLang.Status
                        </th>
                    </tr>
                </thead>
            </table>
            <div id="divResult" style="max-height: 530px; overflow-y:auto">
                <div style="width: 690px">
                    <table class="main" id="header">
                        <colgroup>
                            <col width='80px' />
                            <col width='300px' />
                            <col width='80px' />
                            <col width='80px' />
                            <col width='80px' />
                            <col width='70px' />
                        </colgroup>
                        <tbody>
                        @{
                            Decimal Total = 0;
                         }
                            @foreach (var item in Model.ViewDict)
                            {
                                var NeedSpan = true;
                                Decimal SubTotal = 0;
                                foreach (var viewModel in item.Value)
                                {
                                    var isLoseSum = false;
                                    <tr>
                                        @if (NeedSpan)
                                        {
                                            var numSpan = item.Value.Count + 1;
                                            <td class="center" rowspan=@numSpan>@Formatter.FormatDate(@item.Key)</td>
                                            NeedSpan = false;
                                        }
                                        <td class="left">
                                            @foreach (var eventItem in viewModel.Events)
                                            {
                                                if (eventItem.HomeId == -1)
                                                {
                                                    <p>@ViewLang.TotalLoseTickets</p>
                                                    isLoseSum = true;
                                                }
                                                else
                                                {
                                                    <p>@CacheRef.GetTeamName(eventItem.HomeId) -vs- @CacheRef.GetTeamName(eventItem.AwayId)</p>
                                                }
                                            }
                                        </td>
                                        <td class="numeric">
                                            @if (isLoseSum)
                                            {
                                                @Html.Raw("-")
                                            }
                                            else
                                            {
                                                @viewModel.Odds.ToString("#,##0.0000")
                                            }
                                        </td>
                                        <td class="numeric">@viewModel.Stake.ToString("#,##0")</td>
                                        @{
                                            var winlossNegative = viewModel.WinLoss < 0 ? "negative" : "";
                                         }                                        
                                        <td class="numeric @winlossNegative">
                                            @viewModel.WinLoss.ToString("#,##0.00")
                                        </td>
                                        <td class="center">@viewModel.StatusString.ToUpper()</td>
                                        @{
                                            Total += viewModel.WinLoss;
                                            SubTotal += viewModel.WinLoss;
                                         }
                                    </tr>
                                }
                                <tr>
                                    @{
                                var SubTotalNegative = SubTotal < 0 ? "negative" : "";
                                    }
                                    <td colspan=3 class="right">@ViewLang.Subtotal</td>
                                    <td class="numeric @SubTotalNegative">@SubTotal.ToString("#,##0.00")</td>
                                    <td></td>
                                </tr>
                            }
                            @if (Model.ViewDict.Count == 0 && Model.OutStanding == -1)
                            {
                                <tr><td class="noinfo" colspan="7">No information is available</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="scrollGridContent" style="max-height: 470px; width: 690px">
                    <table class="main" id="result">
                        <colgroup>
                            <col width='80px' />
                            <col width='300px' />
                            <col width='80px' />
                            <col width='80px' />
                            <col width='80px' />
                            <col width='70px' />
                        </colgroup>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <table class="main foot" id="footer">
                <colgroup>
                    <col width='80px' />
                    <col width='300px' />
                    <col width='80px' />
                    <col width='80px' />
                    <col width='80px' />
                    <col width='70px' />
                </colgroup>
                @if (!(Model.ViewDict.Count == 0 && Model.OutStanding == -1))
                { 
                    <tfoot>
                        <tr>
                            @{
                                var TotalNegative = Total < 0 ? "negative" : "";
                            }
                            <td colspan=4 class="right">@ViewLang.Outstanding:</td>
                            <td class="numeric">@Model.OutStanding.ToString("#,##0.00")</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan=4 class="right">@ViewLang.Total:</td>
                            <td class="numeric @TotalNegative">@Total.ToString("#,##0.00")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
            </div>
        </div>
    </div>
</div>