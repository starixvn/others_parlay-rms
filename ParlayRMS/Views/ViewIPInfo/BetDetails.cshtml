@using Formatter = ParlayRMS.Utility.Formatter﻿
@using ParlayRMS.Models.ViewIpInfo;
@{
    Layout = null;
}
@model CombinationDetailsByDateViews
<div class="boxMain">
    <div class="content">
        <div class="title2">
            @Model.BetTypeName
        </div>
        <div style="margin-left: 12px; margin-bottom: 12px; margin-top: 12px;">
            <table class="main" id="header">
                <colgroup>
                    <col width='80px' />
                    <col width='250px' />
                    <col width='130px' />
                    <col width='80px' />
                    <col width='80px' />
                    <col width='70px' />
                </colgroup>
                <thead>
                    <tr>
                        <th>
                            @ViewLang.Date
                        </th>
                        <th>
                            @ViewLang.Event
                        </th>
                        <th>
                            @ViewLang.Odds
                        </th>
                        <th>
                            @ViewLang.Stake
                        </th>
                        <th>
                            @ViewLang.WinLoss
                        </th>
                        <th>
                            @ViewLang.Status
                        </th>
                    </tr>
                </thead>
            </table>
            <div id="divResult" style="max-height: 530px; overflow-y:auto">
                <div style="width: 690px">
                    <table class="main" id="header">
                        <colgroup>
                            <col width='80px' />
                            <col width='250px' />
                            <col width='130px' />
                            <col width='80px' />
                            <col width='80px' />
                            <col width='70px' />
                        </colgroup>
                        <tbody>
                            @{
                                decimal total = 0;
                            }
                            @foreach (var item in Model.ViewDict)
                            {
                                var needSpan = true;
                                decimal subTotal = 0;
                                foreach (var viewModel in item.Value)
                                {
                                    var isLoseSum = false;
                                    <tr>
                                        @if (needSpan)
                                        {
                                            var numSpan = item.Value.Count + 1;
                                            <td class="center" rowspan=@numSpan>@Formatter.FormatDate(@item.Key)</td>
                                            needSpan = false;
                                        }
                                        <td class="left">
                                            @foreach (var eventItem in viewModel.Events)
                                            {
                                                if (eventItem.HomeId == -1)
                                                {
                                                    <p>@ViewLang.TotalLoseTickets</p>
                                                    isLoseSum = true;
                                                }
                                                else
                                                {
                                                    <p>@CacheRef.GetTeamName(eventItem.HomeId) -vs- @CacheRef.GetTeamName(eventItem.AwayId)</p>
                                                }
                                            }
                                        </td>
                                        <td class="numeric">
	                                        @if (viewModel.IsBoostBonus)
	                                        {
		                                        if ((viewModel.Status == 112 && viewModel.Bba > 0) || viewModel.Status == 0 || viewModel.Status == 1)
		                                        {
			                                        <span style="color: #8f8787; "><b><del>@viewModel.OriginalOdds.ToString("#,##0.####")</del></b></span><br/>
			                                        <span><b>@viewModel.BoostOdds.ToString("#,##0.####")</b></span><br/>
			                                        <div style="background-color: yellow; float: right; display: flex; justify-content: center; align-items: center; padding: 2px;">
				                                        <div class="boostBonus" style="padding-left: 2px; margin-right: 0px;"></div>
				                                        <div style="color: blue;"><b>+@((viewModel.BoostRate * 100).ToString("#,##0.##"))% Boost</b></div>
			                                        </div>
		                                        }
		                                        else
		                                        {
			                                        if (viewModel.Status == 113)
			                                        {
				                                        var oddsData = viewModel.Odds > 0 ? viewModel.Odds : viewModel.OriginalOdds;
				                                        @oddsData.ToString("#,##0.####");
			                                        }
			                                        else
			                                        {
				                                        @viewModel.Odds.ToString("#,##0.####")
			                                        }
			                                        
		                                        }

	                                        }
	                                        else
	                                        {
		                                        if (isLoseSum)
		                                        {
			                                        @Html.Raw("-")
		                                        }
		                                        else
		                                        {
			                                        @viewModel.Odds.ToString("#,##0.0000")
		                                        }
	                                        }
                                        </td>
                                        <td class="numeric">@viewModel.Stake.ToString("#,##0")</td>
                                        @{
                                            var winLossNegative = viewModel.WinLoss < 0 ? "negative" : "";
                                        }
                                        <td class="numeric @winLossNegative">
                                            @viewModel.WinLoss.ToString("#,##0.00")
                                        </td>
                                        <td class="center">@viewModel.StatusString.ToUpper()</td>
                                        @{
                                            total += viewModel.WinLoss;
                                            subTotal += viewModel.WinLoss;
                                        }
                                    </tr>
                                }
                                <tr>
                                    @{
                                        var subTotalNegative = subTotal < 0 ? "negative" : "";
                                    }
                                    <td colspan=3 class="right">@ViewLang.Subtotal</td>
                                    <td class="numeric @subTotalNegative">@subTotal.ToString("#,##0.00")</td>
                                    <td></td>
                                </tr>
                            }
                            @if (Model.ViewDict.Count == 0 && Model.Outstanding == -1)
                            {
                                <tr><td class="noinfo" colspan="7">@ViewLang.NoInformation</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="scrollGridContent" style="max-height: 470px; width: 690px">
                    <table class="main" id="result">
                        <colgroup>
                            <col width='80px' />
                            <col width='250px' />
                            <col width='130px' />
                            <col width='80px' />
                            <col width='80px' />
                            <col width='70px' />
                        </colgroup>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div style="width: 690px" class="mainfooter">
                <table class="main foot" id="footer">
                    <colgroup>
                        <col width='80px' />
                        <col width='250px' />
                        <col width='130px' />
                        <col width='80px' />
                        <col width='80px' />
                        <col width='70px' />
                    </colgroup>
                    @if (!(Model.ViewDict.Count == 0 && Model.Outstanding == -1))
                    {
                        <tfoot>
                            <tr style="background-color:#549cba" class="separateFooter">
                                @{
                                }
                                <td colspan=4 class="right">@ViewLang.Outstanding:</td>
                                <td class="numeric">@Model.Outstanding.ToString("#,##0.00")</td>
                                <td></td>
                            </tr>
                            <tr class="separateFooter">
                                <td colspan=4 class="right">@ViewLang.Total:</td>
                                <td class="numeric">@total.ToString("#,##0.00")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>
</div>