@{
    var title = ViewLang.Parlayrms;
    if (ViewBag.Title != null)
    {
        title += " - " + ViewBag.Title;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta content="text/html" charset="utf-8" />
    <title>@title</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    @Styles.Render("~/Content/Libs/jquery-ui/themes/base/css")
    @Styles.Render("~/Content/Libs/css")
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/Scripts/Libs/js")
    @Scripts.Render("~/Scripts/Core/js")
    <script type="text/javascript">
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }
    </script>
    <meta name="viewport" content="width=device-width" />
    @RenderSection("Head", false)
    @RenderSection("Script", false)
</head>
<body>
    <div id="mainPage">
        <div class="top-bar">
            @Html.Action("_Menu", "Shared", new { area = string.Empty })
        </div>
        @if (ViewBag.HeaderText != null)
        {
            <div class="header showcase">
                <div class="content posrel">
                    <h1>@ViewBag.HeaderText</h1>
                </div>
            </div>
        }
        <div class="body showcase">
            <div class="content">
                <div class="clear-fix">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    <div id="loading" class="loading">
        <img alt="" src="@Url.Content("~/Content/Images/Content/loading12.gif")" />
    </div>
    <div id="popup" class="invisible">
    </div>
    <div id="dialog-message">
    </div>
    @Html.Partial("_Language")
    @Html.Partial("_ConfirmBox", "Shared")
    @Html.Partial("_UpdateLevel", "Shared")

    <script src="@Url.Content("~/auth/recheckinscript")" type="text/javascript"></script>

</body>
</html>
