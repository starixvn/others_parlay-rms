@{
    Layout = null;
}
<div class="popup">
    <div class="popup-content">
        <div class="popup-content-title">
            @if (IsSectionDefined("Title"))
            {
                @RenderSection("Title")
            }
            else
            {
                @ViewBag.Title
            }
        </div>
        <div class="popup-content-linetop" />
        <div class="popup-content-linebottom" />
        @RenderBody()
        <div class="popup-content-actionbar">
            <div id="lineloading" class="popup-content-actionbar-loading">
                <img alt="Loading" src="../../Images/Content/ajax-loader-line-2.gif" />
            </div>
            <div id="errMsg" class="popup-content-actionbar-warningmsg">
            </div>
            <div class="popup-content-actionbar-button">
                <button id="btnSubmit" class="button">
                    <span class="text">@ViewLang.Submit</span>
                </button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $("#btnSubmit").click(function () {
            @ViewBag.Submit;
        });
    });
</script>
