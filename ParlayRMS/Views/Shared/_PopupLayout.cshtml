@{
    Layout = null;
}
<div class="boxMain">
    <div class="container">
        <div class="content">
            <div class="allField">
                <div class="title">
                    @if (IsSectionDefined("Title"))
                    {
                        @RenderSection("Title")
                    }
                    else
                    {
                        @ViewBag.Title
                    }
                </div>
                <div class="lineTop">
                </div>
                <div class="lineBottom">
                </div>
                @RenderBody()
                <div class="actionbar">
                    <div class="actionbar-line">
                        <div id="lineloading" class="line-loading">
                            <img alt="Loading" src="../../Images/Content/ajax-loader-line-2.gif" />
                        </div>
                        <div id="errMsg" class="warningmsg">
                        </div>
                        <div class="button-action">
                            <button id="btnSubmit">
                                <span class="text">@ViewLang.Submit</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $("#btnSubmit").addClass("button");
        $("#btnSubmit").click(function () {
            @ViewBag.Submit;
        });
    });
</script>
