@{
    ViewBag.Title = ViewBag.HeaderText = ViewLang.FavouriteChoice;
}
@Html.Partial("../TopSelection/FilterControl")
<div class="topSelection">
    <div id="topSelectionByTicket">
    </div>
    <div id="seperateDiv" style="clear: both">
    </div>
    <div style="width: 975px;">
        <div id="back" class="back" style="float: right">
        </div>
    </div>
    <div id="topSelectionByTurnover">
    </div>
    <div style="clear: both">
    </div>
    <div style="display: none" id="detailTitle" class="detailTitle">
        <span id="detailFrom"></span>
        <div class="lineDiv">
        </div>
    </div>
    <div id="favoriteEvent">
    </div>
    <div style="clear: both">
    </div>
    <div style="display: none" id="detailTitle2" class="detailTitle">
        <span id="detailFrom2"></span>
        <div class="lineDiv">
        </div>
    </div>
    <div id="favoriteBetType">
    </div>
    <div id="favoriteChoice">
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $('#btnSearch').click(function () { RenderChartByFilter(null) });

        enableCache(@ViewBag.IsCache);

        $('#rdbfavouritechoice').click(function(){
            window.location.href = '@Url.Content("~/FavouriteChoice")';
        });

        $('#rdbfavouritechoice').attr('checked', true);

        $('#rdbselection').click(function(){
            window.location.href = '@Url.Content("~/TopSelection")';
        });

        $('#rdbtabular').hide();
        $('#lbltabular').hide();
    });

    var isFavourite = true;

    var _resource = {
        'ticket':'@ViewLang.DetailsFromTickets',
        'turnover':'@ViewLang.DetailsFromTurnover',
        'detailLeagues':'@ViewLang.DetailFromTopLeagues',
        'detailCurrencies':'@ViewLang.DetailFromTopCurrencies',
        'topLeagues':'@ViewLang.TopLeagues',
        'topCurrencies':'@ViewLang.TopCurrencies',
        'selections':'@ViewLang.Selection',
        'allSports':'@ViewLang.Allsports',
        'soccerOnly':'@ViewLang.Socceronly',
        'combinedSports':'@ViewLang.Combinedsports',
        'otherSports':'@ViewLang.Othersports',
        'byturnover' : '@ViewLang.byturnover',
        'byticket' : '@ViewLang.bynoofticket',
        'detailPopularEvent': '@ViewLang.DetailFromPopularEvent',
        'notAvailable': '@ViewLang.NotAvailable'
         };
</script>
@section Script{
    @Scripts.Render("~/Scripts/Data/js")
    @Scripts.Render("~/Scripts/Tabular/js")
    @Scripts.Render("~/Scripts/Chart/js")
    @Scripts.Render("~/Scripts/Cache/js")
    @Scripts.Render("~/Scripts/Monitoring/js")
}
