@using ParlayRMS.Web.Context
@model ParlayRMS.ViewModel.Account.LoginModel
<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewLang.Login</title>
    @Styles.Render("~/Content/Validators")
    @Styles.Render("~/Content/Login")
    @Scripts.Render("~/Scripts/Libs/js")
    @Scripts.Render("~/Scripts/Login/js")
</head>
<body>
    @using (Html.BeginForm())
    {
        <div class="content" style="text-align: center">
            <div class="loginheader">
                <div class="loginlogo">
                </div>
                <div class="blank">
                </div>
            </div>
            <div class="loginboder">
                <div style="width: 100%;">
                </div>
                <div>
                    @Html.LabelFor(m => m.UserName, ViewLang.Username)@Html.TextBoxFor(m => m.UserName, new { @class = "inputLogin" })
                </div>
                <div>
                    @Html.LabelFor(m => m.Password, ViewLang.Password)@Html.PasswordFor(m => m.Password, new { @class = "inputLogin" })
                </div>
                <div>
                    <button class="button" type="submit" id="submit" title="@ViewLang.Login">
                        @ViewLang.Login
                    </button>
                </div>
                @if (ViewBag.ErrorMessage != null)
                { 
                    <div class="errmsg">
                        @ViewBag.ErrorMessage
                    </div>
                }
            </div>
        </div>
    }
    <script type="text/javascript">
        $(function () {
            $('#Password').keypress(function (event) {
                if (event.keyCode == 13) {
                    $('#submit').click();
                }
            });

            return false;
        })
    </script>
</body>
</html>
