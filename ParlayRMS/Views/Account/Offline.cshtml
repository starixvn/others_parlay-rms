<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>@ViewLang.UnderMaintenance</title>
    <link href="~/Content/under-maintenance.css" rel="stylesheet" />
</head>
<body>
    <div class="contain">
        <div class="text_time" style="margin-top: 100px; padding-left: 9px; top: 0px;">
            @(ViewBag.UmFromTime)
            <font color="#555">until</font>
            @(ViewBag.UmToTime)</div>
        <div class="text_time" style="margin-top: 77px; padding-left: 85px; top: 118px;">
            @(ViewBag.UmFromTime)
            <font color="#555">至</font>
            @(ViewBag.UmToTime)</div>
    </div>
    @Scripts.Render("~/Scripts/Libs/js")
    @Scripts.Render("~/Scripts/UnderMaintenance/js")
    <script type="text/javascript">
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }

        function navigateToUrl(url, delayTime) {
            if (delayTime == undefined) delayTime = 2000;
            setInterval("window.location.replace('" + resolveClientUrl(url) + "');", delayTime);
        }
    </script>
</body>
</html>