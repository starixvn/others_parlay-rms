<html lang="en">
<head>
    <title>@ViewLang.UnderMaintenance</title>
    @Styles.Render("~/Content/Site/css")
</head>
<body>
    <div class="UnderMaintenance">
        <h2>
            @ViewLang.UnderMaintenance</h2>
        We are having server maintenance, website will be unavailable from&nbsp;<b>@(ViewBag.UmFromTime)</b>
        &nbsp;to&nbsp;<b>@(ViewBag.UmToTime)</b>&nbsp;. Sorry for the inconveniences caused!
    </div>
    @Scripts.Render("~/Scripts/Libs/js")
    @Scripts.Render("~/Scripts/UnderMaintenance/js")
    <script type="text/javascript">
        function resolveClientUrl(relativeUrl) {
            return '@Url.Content("~/")' + relativeUrl;
        }

        function navigateToUrl(url, delayTime) {
            if (delayTime == undefined) delayTime = 2000;
            setInterval("window.location.replace('" + resolveClientUrl(url) + "');", delayTime);
        }
    </script>
</body>
</html>
