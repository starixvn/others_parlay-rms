@model List<ParlayRMS.DTO.TotalOutstanding.RMS_Rpt_Parlay_Outstanding_Ag>
@{
    int id = 0;
    var totalData = (ParlayRMS.ViewModel.TotalOutstanding.TotalDataModel)ViewBag.TotalData;
}
<div style="width: 571px">
    <table class="main">
        <colgroup>
            <col width='30px' />
            <col width='170px' />
            <col width='120px' />
            <col width='150px' />
            <col width='100px' />
        </colgroup>
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>
                    @ViewLang.MemberUsername
                </th>
                <th>
                    @ViewLang.StakeAfterPT
                </th>
                <th>
                    @ViewLang.MaxPayoutAfterPT
                </th>
                <th>
                    @ViewLang.TotalBets
                </th>
            </tr>
        </thead>
    </table>
</div>
<div class="scrollGridContent" style="max-height: 500px; width: 590px">
    <table class="main" id="result">
        <colgroup>
            <col width='30px' />
            <col width='170px' />
            <col width='120px' />
            <col width='150px' />
            <col width='100px' />
        </colgroup>
        <tbody>
            @foreach (var item in Model)
            { 
                <tr>
                    <td class="numeric">
                        @(++id)
                    </td>
                    <td>
                        <a href="#" onclick="javascript:ParlayRMS.TotalOutstanding.ViewMember('@item.Username');">
                            @item.Username
                        </a>
                    </td>
                    <td class="numeric">
                        @Formatter.FormatNumber2(item.StakePt)
                    </td>
                    <td class="numeric">
                        @Formatter.FormatNumber2(item.MaxPayoutPt)
                    </td>
                    <td class="center">
                        @item.BetCount
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div style="width: 571px" class="mainfooter">
    <table class="main" id="footer">
        <colgroup>
            <col width='30px' />
            <col width='170px' />
            <col width='120px' />
            <col width='150px' />
            <col width='100px' />
        </colgroup>
        <tfoot>
            @if (totalData != null)
            { 
                <tr>
                    <td colspan="2" class="center">
                        @ViewLang.Total
                    </td>
                    <td class="numeric">
                        @Formatter.FormatNumber2(totalData.StakePt)
                    </td>
                    <td class="numeric">
                        @Formatter.FormatNumber2(totalData.MaxPayoutPt)
                    </td>
                    <td class="center">
                        @Formatter.FormatNumber2(totalData.TotalBets)
                    </td>
                </tr>
            }
            else
            { 
                <tr>
                    <td colspan="5" style="text-align: center">
                        @ViewLang.NoInformation
                    </td>
                </tr>
            }
        </tfoot>
    </table>
</div>
