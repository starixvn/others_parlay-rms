@using ParlayRMS.Web.Mvc
@model ParlayRMS.ViewModel.TotalOutstanding.IndexModel
@{
    ViewBag.Title = ViewBag.HeaderText = ViewLang.TotalOutstanding;
}
<div class="filter">
    <div class="filter-control" style="border: 1px solid black; width: 750px;">
        <div class="minimizetitle">
            <div class="minimizecontent">
                @ViewLang.FilterControl</div>
            <div id="filterminimize" class="minimize" onclick="Minimize('filtercontent','filterminimize');">
                -
            </div>
        </div>
        <div id="filtercontent" class="container">
            <div>
                <table>
                    <tbody>
                        <tr>
                            <td>
                                @Html.Label("", @ViewLang.Date)
                            </td>
                            <td>
                                @Html.TextBox("date", Model.Date)
                            </td>
                            <td style="width: 30px">
                                @Html.Label("combo", ViewLang.Combo, new { @class = "lable" })
                            </td>
                            <td style="width: 100px">
                                @Html.DropDownListWithMultipleSelected("combo", (List<SelectListItem>)ViewBag.Combos)
                            </td>
                            <td style="width: 90px">
                                @Html.Label("sportsType", ViewLang.SportsType, new { @class = "lable" })
                            </td>
                            <td style="width: 150px">
                                @Html.DropDownListWithMultipleSelected("sportsType", (List<SelectListItem>)ViewBag.SportsTypes)
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @Html.Label("username", ViewLang.Username2 + "(*)", new { @class = "lable" })
                            </td>
                            <td>
                                @Html.TextBox("username", Model.Username)
                            </td>
                            <td colspan="3">
                                @Html.Label("searchby", @ViewLang.SearchBy)
                                @Html.RadioButton("searchby", "0", true, new { @id = "member" })
                                @Html.Label("member", ViewLang.Member, new { @class = "radiotag" })
                                @Html.RadioButton("searchby", "1", false, new { @id = "agent" })
                                @Html.Label("agent", ViewLang.Agent, new { @class = "radiotag" })
                            </td>
                            <td>
                                <button id="submit" class="button">
                                    <span class="text">@ViewLang.Submit</span>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div style="clear: both; display: none" id="result">
</div>
@Scripts.Render("~/Scripts/TotalOutstanding/js")