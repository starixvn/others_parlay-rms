@using ParlayRMS.Web.Mvc
@model ParlayRMS.ViewModel.TotalOutstanding.IndexModel
@{
    ViewBag.Title = ViewBag.HeaderText = ViewLang.TotalOutstanding;
}
<div class="filter">
    <div class="filter-control" style="border: 1px solid black; width: 100%;">
        <div class="minimizetitle">
            <div class="minimizecontent">
                @ViewLang.FilterControl
            </div>
            <div id="filterminimize" class="minimize" onclick="Minimize('filtercontent','filterminimize');">
                -
            </div>
        </div>
        <div id="filtercontent" class="container">
            <div>
                <table>
                    <tbody>
                        <tr>
                            <td>
                                @Html.Label("username", ViewLang.Username2 + "(*)", new { @class = "lable" })
                            </td>
                            <td>
                                @Html.TextBox("username", Model.Username)
                            </td>
                            <td>
                                <p id="lbCustomerClass" style="padding: 10px 0px;">(CC:)</p>
                            </td>
                            <td style="width: 30px">
                                @Html.Label("combo", ViewLang.Combo, new { @class = "lable" })
                            </td>
                            <td style="width: 100px">
                                @Html.DropDownListWithMultipleSelected("combo", (List<SelectListItem>)ViewBag.Combos)
                            </td>
                            <td style="width: 90px">
                                @Html.Label("parlaysType", ViewLang.ParlayType, new { @class = "lable" })
                            </td>
                            <td style="width: 150px">
                                @Html.DropDownListWithMultipleSelected("parlaysType", (List<SelectListItem>)ViewBag.ParlayTypes)
                            </td>
                            <td style="width: 15px"></td>
                            <td style="width: 125px;">
                                @Html.CheckBox("cornerParlay")
                                @Html.Label("cornerParlay", ViewLang.CornerParlay, new { @class = "lable" })
                            </td>
                            <td style="width: 90px">
                                @Html.Label("sportsType", ViewLang.SportsType, new { @class = "lable" })
                            </td>
                            <td style="width: 150px">
                                @if (string.IsNullOrEmpty(Model.SportsType))
                                {
                                    @RazorHelper.SportTypesDropDown()
                                }
                                else
                                {
                                    @RazorHelper.SportTypesDropDown(Model.SportsType)
                                }
                            </td>
                            <td>
                                <button id="submit" class="button">
                                    <span class="text">@ViewLang.Submit</span>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div style="clear: both; display: none" id="divResult">
</div>
@Scripts.Render("~/Scripts/TotalOutstanding/js?v=1")