@model List<ParlayRMS.DTO.TotalOutstanding.RMS_Rpt_Parlay_Outstanding_Mem>
@{
    int id = 0;
    var totalData = (ParlayRMS.ViewModel.TotalOutstanding.TotalDataModel)ViewBag.TotalData;
}
<table class="main">
    <thead>
        <tr>
            <th style="width: 30px">
                #
            </th>
            <th style="width: 170px">
                @ViewLang.TransTime
            </th>
            <th style="width: 100px">
                @ViewLang.BetID
            </th>
            <th style="width: 80px">
                @ViewLang.Odds
            </th>
            <th style="width: 120px">
                @ViewLang.StakeAfterPT
            </th>
            <th style="width: 150px">
                @ViewLang.MaxPayoutAfterPT
            </th>
            <th style="width: 100px">
                @ViewLang.TotalCombo
            </th>
            <th style="width: 100px">
                @ViewLang.BetDetails
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        { 
            <tr>
                <td class="numeric">
                    @(++id)
                </td>
                <td>
                    @item.TransDate
                </td>
                <td class="numeric">
                    <a href="#" onclick="javascript:ParlayRMS.TotalOutstanding.ViewSimilarBets(@item.TransId);">
                        @item.TransId
                    </a>
                </td>
                <td class="numeric">
                    @Formatter.FormatNumber2(item.Odds)
                </td>
                <td class="numeric">
                    @Formatter.FormatNumber2(item.StakePt)
                </td>
                <td class="numeric">
                    @Formatter.FormatNumber2(item.MaxPayoutPt)
                </td>
                <td class="center">
                    @item.Combo
                </td>
                <td class="center">
                    <button class="button-disable" style="width:40px;" onclick="ParlayRMS.TotalOutstanding.ViewBetDetails('@ViewBag.Username', @item.TransId, @item.Refno, @item.Refno);">
                        @ViewLang.View
                    </button>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        @if (totalData != null)
        { 
            <tr>
                <td colspan="4" class="center">
                    @ViewLang.Total
                </td>
                <td class="numeric">
                    @Formatter.FormatNumber2(totalData.StakePt)
                </td>
                <td class="numeric">
                    @Formatter.FormatNumber2(totalData.MaxPayoutPt)
                </td>
                <td colspan="2">
                </td>
            </tr>
        }
        else
        { 
            <tr>
                <td colspan="8" style="text-align: center">
                    @ViewLang.NoInformation
                </td>
            </tr>
        }
    </tfoot>
</table>
