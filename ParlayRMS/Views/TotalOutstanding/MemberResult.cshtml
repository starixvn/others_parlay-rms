@model List<ParlayRMS.DTO.TotalOutstanding.RMS_Rpt_Parlay_Outstanding_Mem>
@{
    int id = 0;
    var totalData = (ParlayRMS.ViewModel.TotalOutstanding.TotalDataModel)ViewBag.TotalData;
}
<div style="width: 1075px">
    <table class="main" id="header">
        <colgroup>
            <col width='30px' />
            <col width='170px' />
            <col width='130px' />
            <col width='75px' />
            <col width='120px' />
            <col width='120px' />
            <col width='90px' />
            <col width='90px' />
            <col width='130px' />
            <col width='100px' />
        </colgroup>
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th class="sortable" data-col-type="date" id="transTime">
                    @ViewLang.TransTime
                </th>
                <th>
                    @ViewLang.BetID
                </th>
                <th>
                    @ViewLang.Odds
                </th>
                <th>
                    @ViewLang.AverageStakeAfterPT
                </th>
                <th>
                    @ViewLang.NetWinAfterPT
                </th>
                <th>
                    Total Combo Bets
                </th>
                <th>
                    @ViewLang.TotalSelections
                </th>
                <th>
                    Sport Type
                </th>
                <th>
                    @ViewLang.BetDetails
                </th>
            </tr>
        </thead>
    </table>
</div>
<div class="scrollGridContent" style="max-height: 500px; width: 1075px">
    <table class="main" id="result">
        <colgroup>
            <col width='30px' />
            <col width='170px' />
            <col width='130px' />
            <col width='75px' />
            <col width='120px' />
            <col width='120px' />
            <col width='90px' />
            <col width='90px' />
            <col width='130px' />
            <col width='100px' />
        </colgroup>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="numeric">
                        @(++id)
                    </td>
                    <td>
                        @item.TransDate
                    </td>
                    <td class="numeric">
                        <a href="#" onclick="javascript:ParlayRMS.TotalOutstanding.ViewSimilarBets(@item.TransId);">
                            @item.TransId
                        </a>
                    </td>
                    <td class="numeric">
                        @Formatter.FormatOdds(item.Odds)
                    </td>
                    <td class="numeric">
                        @Formatter.FormatNumber2(item.StakePt)
                    </td>
                    <td class="numeric">
                        @Formatter.FormatWithoutRounding(item.MaxPayoutPt)
                    </td>
                    <td class="center">
                        @{
                            var betText = item.BetType == 38 ? " bet(S)" : (item.TotalBet > 1 ? " bets" : " bet");
                        }

                        @Formatter.FormatNumber3(@item.TotalBet) @betText
                    </td>
                    <td class="center">
                        @if (item.NumberWon == 0 || item.BetType == (int)BetType.SingleMatchParlay)
                        {
                            @Html.Raw(item.TotalSelection)
                        }
                        else
                        {
                            @Html.Raw(string.Format("{0}/{1}", item.NumberWon, item.TotalSelection))
                        }
                        
                    </td>
                    <td class="center">
                        @item.SportTypeName
                    </td>
                    <td class="center">
                        <button class="button-disable" style="width:40px;" onclick="ParlayRMS.TotalOutstanding.ViewBetDetails('@ViewBag.Username', @item.TransId, @item.Refno, @item.BetType, @ViewBag.CustId);">
                            @ViewLang.View
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div style="width: 1056px" class="mainfooter">
    <table class="main" id="footer">
        <colgroup>
            <col width='30px' />
            <col width='170px' />
            <col width='100px' />
            <col width='75px' />
            <col width='120px' />
            <col width='120px' />
            <col width='90px' />
            <col width='90px' />
            <col width='130px' />
            <col width='100px' />
        </colgroup>
        <tfoot>
            @if (totalData != null)
            { 
                <tr>
                    <td colspan="4" class="center">
                        @ViewLang.Total
                    </td>
                    <td class="numeric">
                        @Formatter.FormatNumber2(totalData.StakePt)
                    </td>
                    <td class="numeric">
                        @Formatter.FormatWithoutRounding(totalData.MaxPayoutPt)
                    </td>
                    <td colspan="4">
                    </td>
                </tr>
            }
            else
            { 
                <tr>
                    <td colspan="11" style="text-align: center">
                        @ViewLang.NoInformation
                    </td>
                </tr>
            }
        </tfoot>
    </table>
</div>
