@using ParlayRMS.DTO;
@using ParlayRMS.Utility;
@using ParlayRMS.DTO.MixParlayMonitor;
@model IEnumerable<RMS_Monitor_Parlay_Betlist>
@{
    Layout = null;
}
@{
    if (Model == null)
    {
    <tr style="height: 22px;">
        <td colspan="8" class="center">@ViewLang.NoInformation
        </td>
    </tr>
    }
    else
    {
        foreach (var item in Model)
        {
    <tr style="height: 22px;">
        <td>
            @item.TransDate
        </td>
        <td class="numeric">
            <a href="#" onclick="window.open(resolveClientUrl('Report/SimilarBets?betid=@item.TransId'), '_blank');">@item.TransId</a>
        </td>
        <td>
            @item.Username
        </td>
        <td class="numeric">
            @item.Odds.ToString("#,##0.00")
        </td>
        <td class="numeric">
            @item.Stake.ToString("#,##0.00")
        </td>
        <td class="numeric">
            @item.MaxPayout.ToString("#,##0.00")
        </td>
        <td class="center">
            @item.Combo
        </td>
        <td class="center">
            <button class="button-disable-2" style="width:40px;" onclick="ViewBetDetails('@item.Username', @item.TransId, @item.RefNo);">
                @ViewLang.View
            </button>
        </td>
    </tr>
        }
    }
}