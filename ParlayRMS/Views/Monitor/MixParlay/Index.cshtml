@{
    ViewBag.Title = ViewBag.HeaderText = ViewLang.MixParlayMonitor;
}
@Html.Action("MixParlayFilter")
<div style="clear: both; display: none" id="divResult">
    <div style="width: 1120px">
        <table class="main">
            <colgroup>
                <col width='150px' />
                <col width='120px' />
                <col width='150px' />
                <col width='120px' />
                <col width='150px' />
                <col width='180px' />
                <col width='120px' />
                <col width='100px' />
            </colgroup>
            <thead>
                <tr>
                    <th>
                        @ViewLang.TransTime
                    </th>
                    <th>
                        @ViewLang.BetID
                    </th>
                    <th>
                        @ViewLang.Username
                    </th>
                    <th>
                        @ViewLang.Odds
                    </th>
                    <th>
                        @ViewLang.StakeAfterPT
                    </th>
                    <th>
                        @ViewLang.MaxPayoutAfterPT
                    </th>
                    <th>
                        @ViewLang.TotalCombo
                    </th>
                    <th>
                        @ViewLang.BetDetails
                    </th>
                </tr>
            </thead>
        </table>
    </div>
    <div class="scrollGridContent" style="max-height: 710px; width: 1110px">
        <table class="main" id="result">
            <colgroup>
                <col width='150px' />
                <col width='120px' />
                <col width='150px' />
                <col width='120px' />
                <col width='150px' />
                <col width='180px' />
                <col width='120px' />
                <col width='100px' />
            </colgroup>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
@Scripts.Render("~/Scripts/Monitor/MixParlay/js")
@Scripts.Render("~/Scripts/Member/Core/js")
<script type="text/javascript">
    var _resource = {
        'allSports': '@ViewLang.Allsports',
        'soccerOnly': '@ViewLang.Socceronly',
        'combinedSports': '@ViewLang.Combinedsports',
        'otherSports': '@ViewLang.Othersports'
    };
</script>
