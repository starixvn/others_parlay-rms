@using ParlayRMS.DTO.LeagueBetTypeAnalysis;
@using System;
@model IEnumerable<RMS_Rpt_LeagueBettype_Analysis>

<div style="width: 1190px">
    <table class="main" id="header">
        <colgroup>
            <col width='70px' />
            <col width='170px' />
            <col width='120px' />
            <col width='120px' />
            <col width='120px' />
            <col width='80px' />
            <col width='150px' />
            <col width='120px' />
            <col width='120px' />
            <col width='120px' />
        </colgroup>
        <thead>
            <tr>
                <th>
                    @ViewLang.No
                </th>
                <th>
                    @ViewLang.Bettype
                </th>
                <th class="sortable" data-col-index="1">
                    @ViewLang.TotalTickets
                </th>
                <th>
                    @ViewLang.WonTickets
                </th>
                <th>
                    @ViewLang.DrawTickets
                </th>
                <th>
                    @ViewLang.Ratio
                </th>
                <th>
                    @ViewLang.ParlayWonTickets
                </th>
                <th>
                    @ViewLang.Turnover
                </th>
                <th>
                    @ViewLang.MemberWinLoss
                </th>
                <th>
                    @ViewLang.HouseWinLoss
                </th>
            </tr>
        </thead>
    </table>
</div>
<div class="scrollGridContent" id="scrollGridContent" style="max-height: 500px; width: 1210px">
    <table class="main" id="result">
        <colgroup>
            <col width='70px' />
            <col width='170px' />
            <col width='120px' />
            <col width='120px' />
            <col width='120px' />
            <col width='80px' />
            <col width='150px' />
            <col width='120px' />
            <col width='120px' />
            <col width='120px' />
        </colgroup>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="center">
                        @item.No
                    </td>
                    <td class="left">
                        @item.Bettype
                    </td>
                    <td class="numeric">
                        @Formatter.FormatNumber3(item.TotalTickets)
                    </td>
                    <td class="numeric">
                        @Formatter.FormatNumber3(item.WonTickets)
                    </td>
                    <td class="numeric">
                        @Formatter.FormatNumber3(item.DrawTickets)
                    </td>
                    <td class="center">
                        @item.Ratio
                    </td>
                    <td class="numeric">
                        @Formatter.FormatNumber3(item.ParlayWonTickets)
                    </td>
                    <td class="numeric">
                        @Formatter.FormatNumber3(item.TurnOver)
                    </td>
                    <td class="numeric">
                        @Formatter.FormatNumber3(item.MemberWinloss)
                    </td>
                    <td class="numeric">
                        @Formatter.FormatNumber3(item.MainHouseWinloss)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div style="width: 1190px" class="mainfooter">
    <table class="main" id="footer">
        <colgroup>
            <col width='70px' />
            <col width='170px' />
            <col width='120px' />
            <col width='120px' />
            <col width='120px' />
            <col width='80px' />
            <col width='120px' />
            <col width='120px' />
            <col width='120px' />
            <col width='120px' />
        </colgroup>
        <tfoot>
            @if (Model.Count() == 0)
            {
                <tr><td class="noinfo" colspan="10">@ViewLang.NoInformation</td></tr>
            }
        </tfoot>
    </table>
</div>