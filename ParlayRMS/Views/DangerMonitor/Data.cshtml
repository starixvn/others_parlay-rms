@using ParlayRMS.DTO.DangerMonitor
@model IEnumerable<RMS_Rpt_Parlay_DangerMonitor>
@{
    var counter = 0;
}
@Html.Hidden("hdfMaxTransId", (long)ViewBag.MaxTransId)
<div style="width: 1230px">
    <table class="main">
        <colgroup>
            <col width='70px' />
            <col width='260px' />
            <col width='350px' />
            <col width='70px' />
            <col width='70px' />
            <col width='70px' />
            <col width='70px' />
            <col width='70px' />
            <col width='70px' />
            <col width='70px' />
            <col width='70px' />
        </colgroup>
        <thead>
            <tr>
                <th rowspan="2" class="header2rows">
                    @ViewLang.No
                </th>
                <th>
                    @ViewLang.Total
                </th>
                <th style="font-size: 1.0em;">
                    @Formatter.FormatNumber3((int)ViewBag.Total)
                </th>
                <th colspan="2">
                    @ViewLang.HdpFullTime
                </th>
                <th colspan="2">
                    @ViewLang.HdpFirstHalf
                </th>
                <th colspan="2">
                    @ViewLang.OUFullTime
                </th>
                <th colspan="2">
                    @ViewLang.OUFirstHalf
                </th>
            </tr>
            <tr>
                <th>
                    @ViewLang.League
                </th>
                <th>
                    @ViewLang.Match
                </th>
                <th>H</th>
                <th class="awayTeam">A</th>
                <th>H</th>
                <th class="awayTeam">A</th>
                <th>H</th>
                <th class="awayTeam">A</th>
                <th>H</th>
                <th class="awayTeam">A</th>
            </tr>
        </thead>
    </table>
</div>
@if (Model.Count() > 0)
{
    <div class="scrollGridContent" style="max-height: 600px; width: 1247px">
        <table class="main" id="result">
            <colgroup>
                <col width='70px' />
                <col width='260px' />
                <col width='350px' />
                <col width='70px' />
                <col width='70px' />
                <col width='70px' />
                <col width='70px' />
                <col width='70px' />
                <col width='70px' />
                <col width='70px' />
                <col width='70px' />
            </colgroup>
            <tbody>
            @{
                var rowClass = string.Empty;
                foreach (var item in Model)
                {
                    if (counter % 2 == 1)
                    {
                        rowClass = "even";
                    }
                    else
                    {
                        rowClass = "odd";
                    }
                                <tr class="@rowClass">
                                    <td>@(++counter)</td>
                                    <td>@item.LeagueName</td>
                                    <td><a href="#" data-match="@item.MatchId">@item.MatchName</a></td>
                                    <td class="numeric">@(item.HdpHome == 0 ? string.Empty : Formatter.FormatNumber3(item.HdpHome))</td>
                                    <td class="numeric">@(item.HdpAway == 0 ? string.Empty : Formatter.FormatNumber3(item.HdpAway))</td>
                                    <td class="numeric">@(item.Hdp1stHome == 0 ? string.Empty : Formatter.FormatNumber3(item.Hdp1stHome))</td>
                                    <td class="numeric">@(item.Hdp1stAway == 0 ? string.Empty : Formatter.FormatNumber3(item.Hdp1stAway))</td>
                                    <td class="numeric">@(item.OUHome == 0 ? string.Empty : Formatter.FormatNumber3(item.OUHome))</td>
                                    <td class="numeric">@(item.OUAway == 0 ? string.Empty : Formatter.FormatNumber3(item.OUAway))</td>
                                    <td class="numeric">@(item.OU1stHome == 0 ? string.Empty : Formatter.FormatNumber3(item.OU1stHome))</td>
                                    <td class="numeric">@(item.OU1stAway == 0 ? string.Empty : Formatter.FormatNumber3(item.OU1stAway))</td>
                                </tr>
                }
            }
            </tbody>
        </table>
    </div>
}
else
{
    <div style="width: 1230px" class="mainfooter">
        <table class="main" id="footer">
            <colgroup>
                <col width='70px' />
                <col width='260px' />
                <col width='350px' />
                <col width='70px' />
                <col width='70px' />
                <col width='70px' />
                <col width='70px' />
                <col width='70px' />
                <col width='70px' />
                <col width='70px' />
                <col width='70px' />
            </colgroup>
            <tfoot>                
                <tr id="noinfoRow">
                    <td colspan="11" style="text-align: center; width: 1141px">
                        @ViewLang.NoInformation
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
}