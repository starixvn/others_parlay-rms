@model ParlayRMS.ViewModel.ManageMember.SearchBarModel
<div class="search-content" style="width: 530px">
    <div class="search-input">
        @Html.Label("lblUserName", ViewLang.Username)
        @Html.TextBox("txtUserName", @Model.UserName, new { @class = "inputtext w150" })
    </div>
    <div class="level @Model.ClassName">
        <span id="searchLevelName">
            @Model.LevelName
        </span><span id="levelColor" class="arrowDown" vallevel="@Html.DisplayTextFor(m => m.Level)" title="Click to change level">
        </span>
    </div>
    <div class="search-button">
        <button id="memberSearch" onclick="SearchMember_onclick();">
            @ViewLang.Search
        </button>
        &nbsp;
        <button id="memberShowAll" onclick="SearchAllMember_onclick();">
            @ViewLang.ShowAll
        </button>
    </div>
</div>
<ul id="myColor" class="contextMenu">
    <li class="alllevel" title="Click to change level">
        <a href="#" level="" color="alllevel">
            @ViewLang.AllLevel
        </a>
    </li>
    @foreach (var level in ModelsHelper.GetMemberLevels())
    {
        if (level.LevelId == 0)
        {
            <li class="@level.LevelColor" title="Click to change level">
                <a href="#" level="@level.LevelId" color="@level.LevelColor">
                    @ViewLang.None
                </a>
            </li>
        }
        else
        {
            <li class="@level.LevelColor" title="Click to change level">
                <a href="#" level="@level.LevelId" color="@level.LevelColor">
                    @level.LevelValue
                </a>
            </li>
        }
    }
</ul>
<script type="text/javascript">
    $(function () {
        $('#txtUserName').keypress(function (event) {
            if (event.keyCode == 13) {
                SearchMember_onclick();
            }
        });

        $("#memberSearch").button();
        $("#memberShowAll").button();
    });
</script>
