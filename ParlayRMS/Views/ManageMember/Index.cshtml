@using ParlayRMS.DTO.Members;
@using ParlayRMS.Utility;
@model IEnumerable<RMS_CustomerSel>
@{
    ViewBag.Title = ViewBag.HeaderText = ViewLang.MemberManagement;
    string levelName = string.Empty;
}
<div id="barSpecialMember" class="bar new-cmd title" style="width: 550px;">
    @if (ViewBag.HasWritePermission)
    { 
        <div style="float: left;">
            <button id="btnAddSpecialMember" onclick="javascript:AddMember();">
                <span class="addNewUSer"></span><span class="text">@ViewLang.AddSpecialMember</span>
            </button>
        </div>
    }
    <div class="excel" onclick="ExportExcel();" title="Export Excel">
    </div>
</div>
@Html.Action("SearchBar")
<div class="scrollGridBorder" style="width: 560px">
    <div class="scrollGridHeader" style="width: 542px">
        <table class="scrollGrid" style="width: 542px">
            <tr>
                <td style="width: 30px">
                    @ViewLang.No
                </td>
                <td style="width: 50px">
                    @ViewLang.Site
                </td>
                <td style="width: auto">
                    @ViewLang.Username
                </td>
                <td style="width: 130px">
                    @ViewLang.Level
                </td>
            </tr>
        </table>
    </div>
    <div id="content">
    </div>
</div>
@section Script{
    @Scripts.Render("~/Scripts/ManageMember/js")
}
