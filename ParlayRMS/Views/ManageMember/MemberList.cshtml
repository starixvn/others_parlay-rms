@model IEnumerable<RMS_CustomerSel>
@{
    Layout = null;
    var levelName = string.Empty;
}
<div id="groupScrollGrid" class="scrollGridContent" style="width: 560px; max-height: 630px;">
    <table id="tblSpecialMemberList" class="scrollGrid" style="width: 542px;">
        @{
            if (Model == null)
            {
            <tr>
                <td colspan="4" style="text-align: center">
                    @ViewLang.NoInformation
                </td>
            </tr>
            }
        }
        @foreach (var customer in Model)
        {
            <tr>
                <td style="width: 30px; text-align: center">
                    @customer.No
                </td>
                <td style="width: 50px; text-align: center">
                    @customer.Site
                </td>
                <td style="width: auto; padding-left: 3px;">
                    @customer.Username
                </td>
                <td style="width: 130px">
                    @if (customer.Level == 0)
                    {
                        levelName = "None";
                    }
                    else
                    {
                        levelName = "Level " + customer.Level;
                    }
                    <div class="divcolor @ModelsHelper.GetClassByMemberLevel(customer.Level)">
                        <span id="levelName_@customer.Custid">
                            @levelName
                        </span><span title="Click to change level" class="arrowDown_div @Utils.ResolvePermission(ViewBag.HasWritePermission)" level="@customer.Level" custid="@customer.Custid">
                        </span>
                    </div>
                </td>
            </tr>

        }
    </table>
</div>
@Html.Partial("_Pager", (object)@ViewBag.Pager)
