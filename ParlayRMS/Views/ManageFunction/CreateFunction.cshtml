@using ParlayRMS.Models.Functions
@model ParlayRMS.ViewModel.ManageFunction.CreateFunctionModel
@{
    Layout = "~/Views/Shared/_PopupLayout.cshtml";
    ViewBag.Title = ViewLang.NewFunction;
    ViewBag.Submit = "CreateFunctionPost()";
}
<div class="label">
    @Html.LabelFor(m => m.Name)
</div>
<div class="field">
    @Html.TextBoxFor(m => m.Name, new { @class = "inputtext w330" })
</div>
<div class="label">
    @Html.LabelFor(m => m.Key)
</div>
<div class="field">
    @Html.TextBoxFor(m => m.Key, new { @class = "inputtext w330" })
</div>
<div class="label_areatext">
    @Html.LabelFor(m => m.Description)
</div>
<div class="field_areatext">
    @Html.TextAreaFor(m => m.Description, new { @class = "areatext", rows = "7", maxlength = "100", onkeyup = "limitInput(this)" })
</div>
<div class="label">
    @Html.LabelFor(m => m.DisplayOrder)
</div>
<div class="field">
    @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "inputtext w100" })
</div>
<div class="labelNoneBorder">
    @Html.LabelFor(m => m.ParentId)
</div>
<div class="fieldNoneBorder">
    @Html.DropDownListFor(m => m.ParentId, (IEnumerable<SelectListItem>)ViewBag.FunctionSelectList)
</div>