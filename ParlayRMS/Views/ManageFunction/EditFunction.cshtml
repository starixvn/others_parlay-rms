@using ParlayRMS.Models.Functions
@model ParlayRMS.ViewModel.ManageFunction.EditFunctionModel
@{
    Layout = "~/Views/Shared/_PopupLayout.cshtml";
    ViewBag.Title = ViewLang.EditFunction;
    ViewBag.Submit = "EditFunctionPost()";
}
<div class="label">
    @Html.LabelFor(m => m.Name, ViewLang.Name)
    @Html.HiddenFor(m => m.Id)
</div>
<div class="field">
    @Html.TextBoxFor(m => m.Name, Model.Name, new { @class = "inputtext w330" })
</div>
<div class="label_areatext">
    @Html.LabelFor(m => m.Description, ViewLang.Description)
</div>
<div class="field_areatext">
    @Html.TextAreaFor(m => m.Description, new { @class = "areatext", rows = "7", maxlength = "100", onkeyup = "limitInput(this)" })
</div>
<div class="label">
    @Html.LabelFor(m => m.DisplayOrder, ViewLang.Order)
</div>
<div class="field">
    @Html.TextBoxFor(m => m.DisplayOrder, Model.DisplayOrder.ToString(), new { @class = "inputtext w100" })
</div>
<div class="labelNoneBorder">
    @Html.LabelFor(m => m.ParentId, ViewLang.Parent)
</div>
<div class="fieldNoneBorder">
    @Html.DropDownListFor(m => m.ParentId, (IEnumerable<SelectListItem>)ViewBag.FunctionSelectList)
</div>