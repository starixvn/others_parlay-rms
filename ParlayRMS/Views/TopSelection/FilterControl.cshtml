<div class="filter">
    <div class="data" style="width: 440px">
        <div class="minimizetitle">
            <div class="minimizecontent">
                @ViewLang.Summary</div>
            <div id="waiting" class="tabloading">
            </div>
            <div id="dataminimize" class="minimize" onclick="Minimize('dataSum','dataminimize');">
                -
            </div>
        </div>
        <div class="container" id="dataSum">
        </div>
    </div>
    <div class="filter-control" style="width: 450px">
        <div class="minimizetitle">
            <div class="minimizecontent">
                @ViewLang.FilterControl</div>
            <div id="filterminimize" class="minimize" onclick="Minimize('filtercontent','filterminimize');">
                -
            </div>
        </div>
        <div id="filtercontent" class="container">
            <div class="group">
                @Html.Label("selRefreshTime", @ViewLang.Refreshtime)
                <select id="selRefreshTime">
                    <option value="0">@ViewLang.None</option>
                    <option selected="selected" value="30000">30</option>
                    <option value="60000">60</option>
                    <option value="120000">120</option>
                </select>
                @ViewLang.Seconds
            </div>
            <div class="group">
                @Html.Label("selBetType", @ViewLang.Bettype)
                <select id="selBetType">
                    <option value="9">@ViewLang.MixparLay</option>
                </select>
            </div>
            <div class="group">
                @Html.Label("dimensionscontrol", @ViewLang.Dimensions)
                <input type="radio" id="rdbselection" name="dimensionscontrol" />
                <label for="rdbselection" class="radio">@ViewLang.Selection</label>
                <input type="radio" id="rdbfavouritechoice" name="dimensionscontrol" />
                <label for="rdbfavouritechoice" class="radio">@ViewLang.FavouriteChoice</label>
            </div>
            <div class="action">
                <button id="btnSearch">
                    <span class="text">@ViewLang.Submit</span>
                </button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        $("#btnSearch").addClass("button");
    });
</script>
