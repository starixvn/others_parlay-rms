@using ParlayRMS.DTO.Charts
@using ParlayRMS.Utility;
@model IEnumerable<RMS_Monitor_Parlay_Sum>
<table id="tblSum" style="width: 99.5%">
    <thead>
        <tr style="border-bottom: 1px solid #D5D5D5;">
            <td style="width: 60px;">
            </td>
            <td style="width: 100px;">
                @ViewLang.Events
            </td>
            <td style="width: 100px;">
                @ViewLang.Tickets
            </td>
            <td style="width: 100px">
                @ViewLang.Turnover
            </td>
            <td style="width: 100px;">
                @ViewLang.WinLoss
            </td>
            <td style="width: 100px;">
                @ViewLang.OurPT
            </td>
        </tr>
    </thead>
    <tbody>
        @foreach (var data in Model)
        {
            <tr>
                <th>
                    @data.Status
                </th>
                <th>
                    @Utils.ToStringFormat(data.Events)
                </th>
                <th>
                    @Utils.ToStringFormat(data.Tickets)
                </th>
                <th>
                    @Html.Raw(Utils.ToStringFormat(data.Turnover))
                </th>
                @if (data.Status == "Total" || data.Status == "Running")
                {
                    @Html.Raw("<th style='text-align:center'>- </th>")
                }
                else
                {
                    @Html.Raw("<th>" + Utils.ToStringFormat(data.Winloss) + " </th>")
                }
                @if (data.Status == "Total" || data.Status == "Running")
                {
                    @Html.Raw("<th style='text-align:center'>- </th>")
                }
                else
                {
                    @Html.Raw("<th>" + Utils.ToStringFormat(data.CompanyWL) + " </th>")
                }
            </tr>
        }
    </tbody>
</table>
<script type="text/javascript">
    UpdateMaxTransId(@ViewBag.MaxTransId);
    $(document).ready(function () {
        $("#dataSum > table > tbody > tr:nth-child(even)").css("background-color", "#e7e7e7");
    });
</script>