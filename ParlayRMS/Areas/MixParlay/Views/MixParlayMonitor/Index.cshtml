@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = ViewBag.HeaderText = ViewLang.MixParlayMonitor + " (Old)";
}
@Html.Action("Filter")
<div id="noflash" style="display: none">
    Adobe Flash Player or an HTML5 supported browser is required for this feature
    <br />
    Use one of the following ways to get it back:
    <br />
    <ul>
        <li><a href="http://get.adobe.com/flashplayer" target="_blank">Download the latest Flash
            Player </a></li>
        <li><a href="https://www.youtube.com/html5" target="_blank">Upgrade to an HTML5 supported
            browser </a></li>
    </ul>
</div>
<div style="clear: both; display: none" id="divResult">
    <div style="width: 1220px">
        <table class="main" id="header">
            <colgroup>
                <col width='50px' />
                <col width='150px' />
                <col width='125px' />
                <col width='150px' />
                <col width='95px' />
                <col width='150px' />
                <col width='180px' />
                <col width='90px' />
                <col width='100px' />
                <col width='100px' />
            </colgroup>
            <thead>
                <tr>
                    <th>
                        @ViewLang.No
                    </th>
                    <th class="sortable" data-col-type="date" id="transTime">
                        @ViewLang.TransTime
                    </th>
                    <th>
                        @ViewLang.BetID
                    </th>
                    <th class="sortable" data-col-type="ignorecase">
                        @ViewLang.Username
                    </th>
                    <th>
                        @ViewLang.Odds
                    </th>
                    <th class="sortable" data-col-type="float">
                        @ViewLang.StakeAfterPT
                    </th>
                    <th class="sortable" data-col-type="float">
                        @ViewLang.NetWinAfterPT
                    </th>
                    <th>
                        @ViewLang.TotalCombo
                    </th>
                    <th>
                        @ViewLang.IP
                    </th>
                    <th>
                        @ViewLang.BetDetails
                    </th>
                </tr>
            </thead>
        </table>
    </div>
    <div class="scrollGridContent" style="max-height: 645px; width: 1210px">
        <table class="main" id="result">
            <colgroup>
                <col width='50px' />
                <col width='150px' />
                <col width='125px' />
                <col width='150px' />
                <col width='95px' />
                <col width='150px' />
                <col width='180px' />
                <col width='90px' />
                <col width='100px' />
                <col width='100px' />
            </colgroup>
            <tbody>
            </tbody>
        </table>
    </div>
</div>
@Scripts.Render("~/mix-parlay/mix-parlay-monitor")
@Scripts.Render("~/Scripts/Member/Core/js")
<script type="text/javascript">
    var _resource = {
        'allSports': '@ViewLang.Allsports',
        'soccerOnly': '@ViewLang.Socceronly',
        'combinedSports': '@ViewLang.Combinedsports',
        'otherSports': '@ViewLang.Othersports'
    };
    var hasIpPermission = @JavascriptHelper.GetString(ViewBag.HasReadPermission);
</script>
