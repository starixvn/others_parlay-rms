@{
    Layout = "~/Views/Shared/_LayoutAngular.cshtml";
    ViewBag.Title = "<%= title %>";
}
@section Head {
    <% files.css.forEach(function(css){ %>
    <link href="<%= css%>" rel="stylesheet"/><% }) %>
}
<app-root netcore-api-url="@ViewBag.AspNetCoreApiUrl"></app-root>
<% files.js.forEach(function(js){ %>
<script src="<%= js%>"></script><% }) %>
