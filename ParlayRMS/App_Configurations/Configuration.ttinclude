<#+
    enum SiteEnvironment
    {
        DEV,
        LOCAL,
        SIT,
        UAT,
        MNL,
        PRO,
        PROAWS,
    }
    class SiteInfo
    {
        public SiteEnvironment Environment { get; set; }

        public string MSMQPath
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.UAT:
                    case SiteEnvironment.PRO:
                        return @"tcp:10.40.40.22\private$\entlib";
                    case SiteEnvironment.PROAWS:
                        return @"tcp:10.2.27.19\private$\entlib";

                    case SiteEnvironment.MNL:
                        return @"tcp:10.2.98.3\private$\entlib";

                    case SiteEnvironment.SIT:
                        return @"tcp:172.16.4.106\private$\entlib";

                    default:
                        return @"tcp:10.18.200.103\private$\entlib";
                }
            }
        }

       public string ONEbookUMAddress
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
                        return "http://ha.nexdev.net:8889/api";
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
                        return "http://10.99.99.51:8889/api";
                    case SiteEnvironment.UAT:
                        return "http://10.40.40.248:8889/api";
                    case SiteEnvironment.SIT:
                        return "http://172.16.4.106:8889/api";
                    case SiteEnvironment.MNL:
                        return "http://10.40.40.202:8889/api";
                    default:
                        return string.Empty;
                }
            }
        }

        public string EnableCheckUM
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
                    case SiteEnvironment.MNL:
                        return "true";
                    default:
                        return "false";
                }
            }
        }

         public string EnableRecheckIn
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
                    case SiteEnvironment.MNL:
                        return "True";
                    default:
                        return "False";
                }
            }
        }

        public string RemoteRefURL
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.UAT:
                        return "http://10.40.40.248:7207/Main/";
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
                        return "http://10.99.99.51:7258/";
                    case SiteEnvironment.MNL:
                        return "http://10.40.40.202:7258/";
                    case SiteEnvironment.SIT:
                        return "http://172.16.4.105:6207/Main/";
                    default:
                        return "http://ha.nexdev.net:7258/Main/";
                }
            }
        }

        public string ErrorMode
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
                             return "On";

                    default:
                        return "Off";
                }
            }
        }

        public string DebugMode
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
                        return "false";

                    default:
                        return "true";
                }
            }
        }


        public string SessionStateString
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.UAT:
                    case SiteEnvironment.PRO:
                        return "<sessionState cookieName=\".ParlayRMS_ASP.NET_SessionId\" mode=\"StateServer\" timeout=\"10\" stateConnectionString=\"tcpip=10.99.99.51:42424\" />";
                    case SiteEnvironment.PROAWS:
                        return "<sessionState cookieName=\".ParlayRMS_ASP.NET_SessionId\" mode=\"StateServer\" timeout=\"10\" stateConnectionString=\"tcpip=10.2.27.19:42424\" />";
                    case SiteEnvironment.MNL:
                        return "<sessionState cookieName=\".ParlayRMS_ASP.NET_SessionId\" mode=\"StateServer\" timeout=\"10\" stateConnectionString=\"tcpip=10.2.12.10:42424\" />";
                    case SiteEnvironment.SIT:
                        return "<sessionState cookieName=\".ParlayRMS_ASP.NET_SessionId\" mode=\"StateServer\" timeout=\"10\" stateConnectionString=\"tcpip=172.16.4.107:42424\" />";

                    default:
                        return "<sessionState cookieName=\".ParlayRMS_ASP.NET_SessionId\" mode=\"StateServer\" timeout=\"10\" stateConnectionString=\"tcpip=ha.nexdev.net:42424\" />";
                }
            }
        }

		
		public string AspNetCoreAuthUrl
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.UAT:
					 return "https://newparlayrms.starixuat.com";
                    case SiteEnvironment.PRO:
                        return "https://newparlayrms.oneops.net";
                    case SiteEnvironment.PROAWS:
                        return "https://parlayrms-new.sportsfun.app/v1";
                    case SiteEnvironment.MNL:
                        return "";
                    case SiteEnvironment.SIT:
                        return "";
					case SiteEnvironment.LOCAL:
                        return "https://prms-netcore-v1.nexdev.net";
                    default:
                        return "";
                }
            }
        }

		public string FanexLogCategory
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.LOCAL:
					case SiteEnvironment.DEV:
					case SiteEnvironment.SIT:
                        return "NAP-PRMS-LOCAL";

					case SiteEnvironment.UAT:
                        return "NAP-PRMS-UAT";

                    case SiteEnvironment.MNL:
					case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
						return "NAP-PRMS";

					default:
                        return string.Empty;
                }
            }
        }

		public string FanexSentryToken
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.DEV:
					case SiteEnvironment.LOCAL:
					case SiteEnvironment.SIT:
                        return "http://08f559d1c5584860986fc0bb87fab18e@sentry.nexdev.net/94";

					case SiteEnvironment.UAT:
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
					case SiteEnvironment.MNL:
						return "http://3e032e61e03e42c69dc27792ec2df25e@10.99.99.51:801/99";

					default:
                        return string.Empty;
                }
            }
        }
    }
#>