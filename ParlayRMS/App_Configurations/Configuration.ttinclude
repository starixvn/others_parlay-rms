<#+
    enum SiteEnvironment
    {
        DEV,
        LOCAL,
        SIT,
        UAT,
        MNL,
        PRO,
        PROAWS,
        KLDR,
    }
    class SiteInfo
    {
        public SiteEnvironment Environment { get; set; }

       
        public string NapEnvironment
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
                    case SiteEnvironment.KLDR:
                        return "LIVE";
                    default:
                        return "UAT";
                }
            }
        }

        public string NapSiteId
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.UAT:
					case SiteEnvironment.SIT:
                    case SiteEnvironment.KLDR:
                        return "37";
                    default:
                        return "88";
                }
            }
        }

        public string NapEnableReCheckin
        {
            get
            {
                switch(Environment)
                {
                    case SiteEnvironment.PRO:
                    case SiteEnvironment.PROAWS:
                    case SiteEnvironment.KLDR:
                        return "false";
                    default:
                        return "false";
                }
            }
        }

        public string NapServiceUrls
        {
            get
