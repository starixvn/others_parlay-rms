  <dangerousAgents configSource="DangerousAgents.config" />
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
             <add name="XmlDbSettingProvider"
                type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension"
                resourcePath="~/App_Data/Fanex.Data" enableWatching="0" />
        </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Caching cacheType="Fanex.Caching.Memory.MemoryCache, Fanex.Caching">
    <connectionSettings>
      <add name="CompactOnMemoryPressure" value="true" />
      <add name="ExpirationScanFrequency" value="1" />
    </connectionSettings>
  </Fanex.Caching>
 <ONEbook.UM ServiceUris="https://onebookum-dev.nexdev.net/api"
              EnableCheckUM="false"
              EnableUnscheduledUM="false"
              UMFrom="01:00"
              UMTo="23:00"
              SiteId="2000000" UMPageUrl="~/Account/Offline">
    </ONEbook.UM>
  <connectionStrings configSource="App_Configurations\Web.ConnectionString.DEV.config"/>
